<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../.local/GameSnapshot.props" Condition="Exists('../../.local/GameSnapshot.props')" />
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>SphereOpt</AssemblyName>
    <RootNamespace>SphereOpt</RootNamespace>
    <Version>0.9.3</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <OutputPath>../../.local/build/SphereOpt/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../external/SphereOpt/*.cs" />
    <Compile Include="../../external/SphereOpt/thirdparty/**/*.cs" />
    <PackageReference Include="BepInEx.Core" Version="5.4.17" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="1.1.0" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="$(DSPManagedDir)/*.dll"
               Exclude="$(DSPManagedDir)/mscorlib.dll;$(DSPManagedDir)/netstandard.dll;$(DSPManagedDir)/System*.dll;$(DSPManagedDir)/Microsoft*.dll;$(DSPManagedDir)/Mono*.dll">
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <Target Name="VerifyGameInputs" BeforeTargets="ResolveReferences">
    <PropertyGroup>
      <_DSPVerifyGameArgument Condition="'$(DSPGameDir)' != ''">--game &quot;$(DSPGameDir)&quot;</_DSPVerifyGameArgument>
    </PropertyGroup>
    <Exec Command="py -3 &quot;$(MSBuildThisFileDirectory)../game_snapshot.py&quot; verify --managed &quot;$(DSPManagedDir)&quot; $(_DSPVerifyGameArgument)" />
    <Error Condition="!Exists('$(DSPManagedDir)/Assembly-CSharp.dll')" Text="Capture DSP before building." />
    <Error Condition="!Exists('../../external/SphereOpt/SphereOpt.cs')" Text="Clone SphereOpt before building." />
  </Target>
</Project>
