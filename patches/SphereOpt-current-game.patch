@@ -0,0 +1,159 @@
+using System.Diagnostics;
+using System.Reflection;
+using System.Runtime.ExceptionServices;
+using SphereOpt;
+using Plugin = SphereOpt.SphereOpt;
+
+namespace SphereOpt.RenderTests;
+
+internal static class Program
+{
+    private static int Main(string[] args)
+    {
+        if (args.Length != 0 && (args.Length != 2 || args[0] != "--captured-assembly"))
+        {
+            Console.Error.WriteLine("Usage: SphereOpt.RenderTests [--captured-assembly <captured Assembly-CSharp.dll>]");
+            return 2;
+        }
+        var tests = RenderContextTests.Cases().Concat(RewriterIntegrationTests.Cases())
+            .Concat(args.Length == 0 ? [] : CapturedIlTests.Cases(args[1]))
+            .Append(("Isolation/no game, plugin or Unity assembly loaded or referenced", (Action)AssertIsolated))
+            .ToArray();
+        var failed = 0;
+        var elapsed = Stopwatch.StartNew();
+        foreach (var (name, run) in tests)
+        {
+            try
+            {
+                PatchAccess.AssertClear();
+                Plugin.Reset();
+                run();
+                PatchAccess.AssertClear();
+                Console.WriteLine($"PASS {name}");
+            }
+            catch (Exception exception)
+            {
+                failed++;
+                Console.Error.WriteLine($"FAIL {name}: {exception}");
+                // A contaminated context must also fail subsequent checks.
+                // Do not reset the production ThreadStatic field to hide a leak.
+            }
+        }
+        Console.WriteLine($"RESULT total={tests.Length} passed={tests.Length - failed} failed={failed} skipped=0 elapsed={elapsed.Elapsed.TotalSeconds:F3}s");
+        return failed == 0 ? 0 : 1;
+    }
+
+    private static void AssertIsolated()
+    {
+        static bool Forbidden(string name) => name == "Assembly-CSharp" || name == "SphereOpt" ||
+            name.StartsWith("UnityEngine", StringComparison.Ordinal) ||
+            name.StartsWith("BepInEx", StringComparison.Ordinal);
+        var loaded = AppDomain.CurrentDomain.GetAssemblies();
+        var forbidden = loaded.Select(assembly => assembly.GetName().Name)
+            .Concat(loaded.SelectMany(assembly => assembly.GetReferencedAssemblies()).Select(name => name.Name))
+            .Where(Forbidden).Distinct().ToArray();
+        Check.Equal(0, forbidden.Length, $"Forbidden runtime dependencies: {string.Join(", ", forbidden)}");
+        Check.Same(typeof(Program).Assembly, typeof(Patch_DysonSphereSegmentRenderer).Assembly,
+            "Patch must be linked into this harness");
+        Check.Same(typeof(Program).Assembly, typeof(ShellCursorRewriter).Assembly,
+            "Rewriter must be linked into this harness");
+    }
+}
+
+internal static class PatchAccess
+{
+    private static readonly Type Patch = typeof(Patch_DysonSphereSegmentRenderer);
+    internal static readonly MethodInfo Prefix = Method("BeforeDraw");
+    internal static readonly MethodInfo CursorMethod = Method("RenderShellCursor");
+    internal static readonly MethodInfo Finalizer = Method("AfterDraw");
+    internal static readonly MethodInfo Transpiler = Method("DrawModels");
+    private static readonly FieldInfo Current = Patch.GetField("current", BindingFlags.Static | BindingFlags.NonPublic)
+        ?? throw new InvalidOperationException("Production context field not found");
+
+    internal static DrawCall Begin(DysonSphereSegmentRenderer renderer, ERenderPlace place = ERenderPlace.Universe,
+        int editorMask = 0x246, int gameMask = 0x6aa)
+    {
+        object[] args = [renderer, place, editorMask, gameMask, null];
+        var original = (bool)Invoke(Prefix, args);
+        Check.True(args[4] != null, "Every prefix path must provide its own finalizer state");
+        return new DrawCall(args[4], original);
+    }
+
+    internal static int Cursor(DysonSphereLayer layer) => (int)Invoke(CursorMethod, [layer]);
+    internal static void End(object state) => Invoke(Finalizer, [state]);
+    internal static object CurrentContext => Current.GetValue(null);
+    internal static void AssertClear() => Check.True(CurrentContext == null, "Production draw context leaked past finalization");
+
+    internal static object Invoke(MethodInfo method, object[] args)
+    {
+        try { return method.Invoke(null, args); }
+        catch (TargetInvocationException exception) when (exception.InnerException != null)
+        {
+            ExceptionDispatchInfo.Capture(exception.InnerException).Throw();
+            throw;
+        }
+    }
+
+    private static MethodInfo Method(string name) => Patch.GetMethod(name, BindingFlags.Static | BindingFlags.NonPublic)
+        ?? throw new InvalidOperationException($"Production method not found: {name}");
+}
+
+internal sealed class DrawCall(object state, bool original) : IDisposable
+{
+    internal object State { get; } = state;
+    internal bool RunOriginal { get; } = original;
+    // Repeated Dispose deliberately reaches the actual finalizer each time.
+    public void Dispose() => PatchAccess.End(State);
+}
+
+internal sealed class Fixture
+{
+    internal DysonSphere Sphere { get; } = new();
+    internal InstDysonShellRenderer Native { get; } = new();
+    internal DysonSphereSegmentRenderer Segment { get; }
+
+    internal Fixture(int preparedMask = 2, params int[] successfulLayers)
+    {
+        Segment = new DysonSphereSegmentRenderer { dysonSphere = Sphere };
+        for (var id = 1; id <= 10; id++) Sphere.layersIdBased[id] = Layer(id, 20 + id);
+        Native.PreparedMask = preparedMask;
+        Native.SuccessfulLayers = successfulLayers;
+        Plugin.Renderers.Add(Sphere, Native);
+    }
+
+    internal DysonSphereLayer Layer(int id, int cursor = 57)
+        => new() { id = id, shellCursor = cursor, dysonSphere = Sphere };
+
+    internal void AssertCursors(int submittedMask)
+    {
+        for (var id = 1; id <= 10; id++)
+        {
+            var layer = Sphere.layersIdBased[id];
+            Check.Equal((submittedMask & (1 << id)) != 0 ? 1 : layer.shellCursor, PatchAccess.Cursor(layer),
+                $"Suppression mask=0x{submittedMask:x}, layer={id}");
+            Check.Equal(20 + id, layer.shellCursor, "Patch mutated the stored shell cursor");
+        }
+    }
+}
+
+internal static class Check
+{
+    internal static void True(bool condition, string message)
+    {
+        if (!condition) throw new InvalidOperationException(message);
+    }
+
+    internal static void Equal<T>(T expected, T actual, string message)
+        => True(EqualityComparer<T>.Default.Equals(expected, actual), $"{message}: expected {expected}, got {actual}");
+    internal static void Same(object expected, object actual, string message)
+        => True(ReferenceEquals(expected, actual), message);
+    internal static void Sequence<T>(IEnumerable<T> expected, IEnumerable<T> actual, string message)
+        => True(expected.SequenceEqual(actual), message);
+
+    internal static T Throws<T>(Action action) where T : Exception
+    {
+        try { action(); }
+        catch (T exception) { return exception; }
+        throw new InvalidOperationException($"Expected {typeof(T).Name}");
+    }
+}
