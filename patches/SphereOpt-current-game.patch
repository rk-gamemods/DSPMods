+using System.Diagnostics;
+
+namespace SphereOpt.LayerTests;
+
+internal static class Program
+{
+    private static int Main(string[] args)
+    {
+        var repeat = 2;
+        if (args.Length != 0 && (args.Length != 2 || args[0] != "--repeat" || !int.TryParse(args[1], out repeat) || repeat < 1))
+        {
+            Console.Error.WriteLine("Usage: SphereOpt.LayerTests [--repeat positive-integer]");
+            return 2;
+        }
+        Console.WriteLine("API/lifecycle simulation of linked real InstDysonShellLayer + PoolCompaction; NOT a native GPU test.");
+        var tests = LayerTests.Cases().Append(("Isolation/no game or plugin runtime loaded", (Action)Isolated)).ToArray();
+        var failed = 0;
+        var stopwatch = Stopwatch.StartNew();
+        for (var pass = 1; pass <= repeat; pass++)
+        {
+            foreach (var (name, run) in tests)
+            {
+                Exception error = null;
+                Gpu.Reset();
+                try { run(); }
+                catch (Exception exception) { error = exception; }
+                try { Gpu.VerifyTeardown(); }
+                catch (Exception teardown) { error = error == null ? teardown : new AggregateException(error, teardown); }
+                if (error == null) Console.WriteLine($"PASS [{pass}/{repeat}] {name}");
+                else
+                {
+                    failed++;
+                    Console.Error.WriteLine($"FAIL [{pass}/{repeat}] {name}: {error}");
+                }
+            }
+        }
+        var total = repeat * tests.Length;
+        Console.WriteLine($"RESULT cases={tests.Length} repeat={repeat} total={total} passed={total - failed} failed={failed} skipped=0 elapsed={stopwatch.Elapsed.TotalSeconds:F3}s");
+        return failed == 0 ? 0 : 1;
+    }
+
+    private static void Isolated()
+    {
+        var forbidden = AppDomain.CurrentDomain.GetAssemblies().Select(assembly => assembly.GetName().Name ?? "")
+            .Where(name => name is "Assembly-CSharp" or "SphereOpt" or "0Harmony" ||
+                name.StartsWith("UnityEngine", StringComparison.Ordinal) || name.StartsWith("BepInEx", StringComparison.Ordinal));
+        Check.Sequence(Array.Empty<string>(), forbidden, "Forbidden runtime dependencies.");
+    }
+}
+
+internal static class Check
+{
+    internal static void True(bool condition, string message)
+    {
+        if (!condition) throw new InvalidOperationException(message);
+    }
+
+    internal static void Equal<T>(T expected, T actual, string message = "")
+    {
+        if (!EqualityComparer<T>.Default.Equals(expected, actual))
+            throw new InvalidOperationException($"{message} Expected {expected}; got {actual}.");
+    }
+
+    internal static void Same(object expected, object actual, string message)
+        => True(ReferenceEquals(expected, actual), message);
+
+    internal static void Sequence<T>(IEnumerable<T> expected, IEnumerable<T> actual, string message)
+        => True(expected.SequenceEqual(actual), message);
+
+    internal static T Throws<T>(Action action) where T : Exception
+    {
+        try { action(); }
+        catch (T exception) { return exception; }
+        throw new InvalidOperationException($"Expected {typeof(T).Name}.");
+    }
+}
