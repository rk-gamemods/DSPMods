+using System.Collections;
+
+namespace SphereOpt.Tests;
+
+internal static class DispatchPlanTests
+{
+    internal static IEnumerable<(string, Action)> Cases()
+    {
+        int[] counts = [0, 1, 31, 32, 63, 64, 65, 127, 128, 129,
+            65_535, 65_536, 65_537, 1_000_003, 16_777_217, int.MaxValue];
+        uint[] sizes = [1, 32, 64, 128];
+        foreach (var count in counts)
+        foreach (var size in sizes)
+            yield return ($"Dispatch/partition count={count} threads={size}", () => Partition(count, size));
+        yield return ("Dispatch/maximum allowed thread size", () => Partition(int.MaxValue, int.MaxValue));
+        yield return ("Dispatch/invalid instance count", () =>
+            Check.Throws<ArgumentOutOfRangeException>(() => DispatchPlan.Create(-1, 64), "instanceCount"));
+        yield return ("Dispatch/zero thread size", () =>
+            Check.Throws<ArgumentOutOfRangeException>(() => DispatchPlan.Create(1, 0), "threadsPerGroup"));
+        yield return ("Dispatch/thread size exceeds signed range", () =>
+        {
+            Check.Throws<ArgumentOutOfRangeException>(() => DispatchPlan.Create(1, (uint)int.MaxValue + 1), "threadsPerGroup");
+            Check.Throws<ArgumentOutOfRangeException>(() => DispatchPlan.Create(1, uint.MaxValue), "threadsPerGroup");
+        });
+        yield return ("Dispatch/null tail destination even for empty tail", () =>
+        {
+            Check.Throws<ArgumentNullException>(() => DispatchPlan.Create(65, 64).FillTailIndices(null!), "destination");
+            Check.Throws<ArgumentNullException>(() => DispatchPlan.Create(0, 64).FillTailIndices(null!), "destination");
+        });
+        yield return ("Dispatch/short tail buffers rejected without writes", () =>
+        {
+            var plan = DispatchPlan.Create(127, 64);
+            foreach (var length in new[] { 0, 1, 62 })
+            {
+                var destination = Enumerable.Repeat(uint.MaxValue, length).ToArray();
+                Check.Throws<ArgumentException>(() => plan.FillTailIndices(destination), "destination");
+                Check.True(destination.All(value => value == uint.MaxValue), "Rejection partially wrote the buffer");
+            }
+        });
+    }
+
+    private static void Partition(int count, uint threads)
+    {
+        var plan = DispatchPlan.Create(count, threads);
+        Check.True(plan.GroupCount >= 0 && plan.TailStart >= 0, "Negative dispatch extent");
+        Check.True(plan.TailCount >= 0 && plan.TailCount < threads, "Tail is not smaller than a GPU group");
+        var gpuExtent = checked((long)plan.GroupCount * threads);
+        Check.Equal(gpuExtent, (long)plan.TailStart, "GPU and CPU ranges must meet exactly");
+        Check.Equal((long)count, gpuExtent + plan.TailCount, "Partition must cover every valid instance");
+        Check.True(gpuExtent <= count, "GPU overread");
+        Check.True(gpuExtent + threads > count, "GPU omitted a complete group");
+
+        // Enumerate every GPU lane through one million instances. For larger counts,
+        // prove the contiguous intervals in 64-bit arithmetic and sample their edges.
+        var seen = count <= 1_000_003 ? new BitArray(count) : null;
+        void Visit(long index)
+        {
+            Check.True(index >= 0 && index < count, $"Out-of-range instance {index}");
+            if (seen is null) return;
+            Check.True(!seen[(int)index], $"Duplicate instance {index}");
+            seen[(int)index] = true;
+        }
+        if (seen is not null)
+        {
+            for (long group = 0; group < plan.GroupCount; group++)
+            for (long lane = 0; lane < threads; lane++)
+                Visit(group * threads + lane);
+        }
+        else if (plan.GroupCount > 0)
+        {
+            foreach (var group in new HashSet<long> { 0, plan.GroupCount / 2, plan.GroupCount - 1 })
+            {
+                Visit(group * threads);
+                Visit((group + 1) * threads - 1);
+            }
+        }
+
+        var buffer = Enumerable.Repeat(uint.MaxValue, plan.TailCount + 3).ToArray();
+        plan.FillTailIndices(buffer);
+        for (var index = 0; index < plan.TailCount; index++)
+        {
+            Check.Equal((uint)((long)plan.TailStart + index), buffer[index], "Tail order");
+            Check.True(buffer[index] >= gpuExtent, "CPU duplicates GPU work");
+            Visit(buffer[index]);
+        }
+        Check.True(buffer.Skip(plan.TailCount).All(value => value == uint.MaxValue), "Tail fill overwrote guard elements");
+        var firstFill = buffer.ToArray();
+        plan.FillTailIndices(buffer);
+        Check.Sequence(firstFill, buffer, "Repeated tail fill changed output");
+        var exact = new uint[plan.TailCount];
+        plan.FillTailIndices(exact);
+        Check.Sequence(buffer.Take(plan.TailCount), exact, "Exact-size destination");
+        if (seen is not null)
+        {
+            for (var index = 0; index < seen.Length; index++)
+                Check.True(seen[index], $"Missing instance {index}");
+        }
+    }
+}
diff --git a/tests/SphereOpt.Tests/GameAccessTests.cs b/tests/SphereOpt.Tests/GameAccessTests.cs
new file mode 100644
