+            finally { draw.Dispose(); }
+        });
+        Check.Same(originalException, caught, "Void finalizer must not replace an in-flight original exception");
+        Check.Equal(0, Plugin.DisableCalls.Count, "Original exceptions must not be mistaken for optimization failures");
+        inner.AssertCursors(0);
+        if (nested)
+        {
+            Check.Same(first.State, PatchAccess.CurrentContext, "Exception finalization must restore outer state");
+            outer.AssertCursors(1 << 1);
+        }
+        else PatchAccess.AssertClear();
+        PatchAccess.End(endedState);
+        if (nested) outer.AssertCursors(1 << 1);
+        else PatchAccess.AssertClear();
+    }
+
+    private static void ForeignFinalizerState()
+    {
+        var fixture = new Fixture(AllLayers, 1);
+        using var draw = PatchAccess.Begin(fixture.Segment);
+        PatchAccess.End(null);
+        PatchAccess.End(new object());
+        Check.Same(draw.State, PatchAccess.CurrentContext, "Unrelated state must not change the active context");
+        fixture.AssertCursors(1 << 1);
+    }
+
+    private static void RepeatedCleanup()
+    {
+        var a = new Fixture(AllLayers, 1);
+        var b = new Fixture(AllLayers, 2);
+        var first = PatchAccess.Begin(a.Segment);
+        try
+        {
+            var second = PatchAccess.Begin(b.Segment);
+            second.Dispose();
+            second.Dispose();
+            Check.Same(first.State, PatchAccess.CurrentContext, "Repeated nested cleanup must restore the same predecessor");
+            a.AssertCursors(1 << 1);
+            b.AssertCursors(0);
+        }
+        finally { first.Dispose(); }
+        first.Dispose();
+        PatchAccess.AssertClear();
+        a.AssertCursors(0);
+        Check.Equal(0, Plugin.ReleaseCalls, "Context cleanup must not destroy resources");
+    }
+
+    private static void FinalizerContract()
+    {
+        Check.Equal(typeof(void), PatchAccess.Finalizer.ReturnType, "Finalizer must preserve Harmony's original exception");
+        Check.True(PatchAccess.Finalizer.IsDefined(typeof(HarmonyFinalizer), false), "Production finalizer attribute missing");
+        Check.True(PatchAccess.Prefix.IsDefined(typeof(HarmonyPrefix), false), "Production prefix attribute missing");
+        Check.Sequence(new[] { typeof(object) }, PatchAccess.Finalizer.GetParameters().Select(parameter => parameter.ParameterType),
+            "Finalizer consumes prefix state without replacing the exception");
+    }
+
+    private static void ThreadIsolation()
+    {
+        var outer = new Fixture(AllLayers, 1);
+        var inner = new Fixture(AllLayers, 4);
+        using var draw = PatchAccess.Begin(outer.Segment);
+        Exception workerFailure = null;
+        var thread = new Thread(() =>
+        {
+            try
+            {
+                PatchAccess.AssertClear();
+                outer.AssertCursors(0);
+                using (PatchAccess.Begin(inner.Segment))
+                {
+                    inner.AssertCursors(1 << 4);
+                    outer.AssertCursors(0);
+                }
+                PatchAccess.AssertClear();
+            }
+            catch (Exception exception) { workerFailure = exception; }
+        });
+        thread.Start();
+        thread.Join();
+        if (workerFailure != null) throw new InvalidOperationException("Independent thread context failure", workerFailure);
+        Check.Same(draw.State, PatchAccess.CurrentContext, "Worker must not change the parent thread's state");
+        outer.AssertCursors(1 << 1);
+        inner.AssertCursors(0);
+    }
+
+    private static void FreeStatic()
+    {
+        var fixture = new Fixture();
+        var method = typeof(Patch_DysonSphereSegmentRenderer).GetMethod("FreeStatic", BindingFlags.NonPublic | BindingFlags.Static);
+        PatchAccess.Invoke(method, []);
+        Check.Equal(1, Plugin.ReleaseCalls, "Static teardown delegates renderer release");
+        fixture.AssertCursors(0);
+    }
+}
diff --git a/tests/SphereOpt.RenderTests/RewriterIntegrationTests.cs b/tests/SphereOpt.RenderTests/RewriterIntegrationTests.cs
new file mode 100644
index 0000000000000000000000000000000000000000..709ea6f39248fb94a3736a098a7a435b9da0646c
--- /dev/null
+++ b/tests/SphereOpt.RenderTests/RewriterIntegrationTests.cs
@@ -0,0 +1,63 @@
+using System.Reflection;
+using System.Reflection.Emit;
+using HarmonyLib;
+
+namespace SphereOpt.RenderTests;
+
+internal static class RewriterIntegrationTests
+{
+    private static readonly FieldInfo Cursor = typeof(DysonSphereLayer).GetField(nameof(DysonSphereLayer.shellCursor));
+
+    internal static IEnumerable<(string, Action)> Cases()
+    {
+        yield return ("Rewriter/real transpiler emitted fixture observes the real draw context", ExecutableProductionGetter);
+        yield return ("Rewriter/real transpiler rejects changed read counts", UnsupportedReadCounts);
+    }
+
+    private static void ExecutableProductionGetter()
+    {
+        // This tiny, explicitly synthetic body exercises the actual transpiler,
+        // actual rewriter, actual getter, and actual prefix/finalizer together.
+        // It does not claim to be captured DrawModels IL or native execution.
+        CodeInstruction[] input =
+        [
+            new(OpCodes.Ldarg_0), new(OpCodes.Ldfld, Cursor),
+            new(OpCodes.Ldarg_0), new(OpCodes.Ldfld, Cursor),
+            new(OpCodes.Add), new(OpCodes.Ret)
+        ];
+        var output = ((IEnumerable<CodeInstruction>)PatchAccess.Invoke(PatchAccess.Transpiler, [input])).ToArray();
+        Check.Equal(2, output.Count(instruction => instruction.opcode == OpCodes.Call &&
+            Equals(instruction.operand, PatchAccess.CursorMethod)), "Both field reads must call the real production getter");
+        Check.Equal(2, input.Count(instruction => instruction.opcode == OpCodes.Ldfld && Equals(instruction.operand, Cursor)),
+            "Transpiler must not mutate input instructions");
+        var dynamic = new DynamicMethod("RealPatchGetterFixture", typeof(int), [typeof(DysonSphereLayer)], typeof(Program).Module, true);
+        var generator = dynamic.GetILGenerator();
+        foreach (var instruction in output)
+        {
+            if (instruction.operand is MethodInfo method) generator.Emit(instruction.opcode, method);
+            else if (instruction.operand == null) generator.Emit(instruction.opcode);
+            else throw new InvalidOperationException("Unexpected fixture operand");
+        }
+        var readTwice = dynamic.CreateDelegate<Func<DysonSphereLayer, int>>();
+        var fixture = new Fixture(0x7fe, 4);
+        Check.Equal(48, readTwice(fixture.Sphere.layersIdBased[4]), "No context baseline");
+        using (PatchAccess.Begin(fixture.Segment))
+        {
+            Check.Equal(2, readTwice(fixture.Sphere.layersIdBased[4]), "Submitted layer must use the production sentinel twice");
+            Check.Equal(50, readTwice(fixture.Sphere.layersIdBased[5]), "Fallback layer must retain both real field values");
+        }
+        Check.Equal(48, readTwice(fixture.Sphere.layersIdBased[4]), "Finalizer must restore emitted getter fallback");
+    }
+
+    private static void UnsupportedReadCounts()
+    {
+        foreach (var count in new[] { 0, 1, 3 })
+        {
+            var input = Enumerable.Range(0, count).Select(_ => new CodeInstruction(OpCodes.Ldfld, Cursor)).ToArray();
+            Check.Throws<InvalidOperationException>(() =>
+                ((IEnumerable<CodeInstruction>)PatchAccess.Invoke(PatchAccess.Transpiler, [input])).ToArray());
+            Check.True(input.All(instruction => instruction.opcode == OpCodes.Ldfld && Equals(instruction.operand, Cursor)),
+                "Rejected contract must preserve input ownership");
+        }
+    }
+}
