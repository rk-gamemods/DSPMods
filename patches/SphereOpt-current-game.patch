+    private static void AllMaskCombinations()
+    {
+        var combinations = 0;
+        for (var eligible = 0; eligible < 1024; eligible++)
+        for (var submitted = eligible; ; submitted = (submitted - 1) & eligible)
+        {
+            Plugin.Reset();
+            var callbackIds = Enumerable.Range(1, 10).Where(id => (submitted & (1 << (id - 1))) != 0).ToArray();
+            var fixture = new Fixture(eligible << 1, callbackIds);
+            using (var draw = PatchAccess.Begin(fixture.Segment))
+            {
+                Check.True(draw.RunOriginal, "Node/frame/overlay original must still run");
+                fixture.AssertCursors(submitted << 1);
+                Check.Equal(1, fixture.Native.PrepareCalls.Count, "Preparation call count");
+                Check.Equal(eligible == 0 ? 0 : 1, fixture.Native.RenderCalls.Count, "Zero prepared mask must not render");
+                Check.Sequence(callbackIds, fixture.Native.Callbacks, "Completed fake callbacks");
+                Check.Equal(0, Plugin.DisableCalls.Count, "Successful submission must not disable the plugin");
+            }
+            fixture.AssertCursors(0);
+            PatchAccess.AssertClear();
+            combinations++;
+            if (submitted == 0) break;
+        }
+        Check.Equal(59049, combinations, "Every layer must cover ineligible, eligible-unsubmitted, and submitted states");
+    }
