--- /dev/null
+++ b/DispatchPlan.cs
@@ -0,0 +1,36 @@
+using System;
+
+namespace SphereOpt
+{
+    internal readonly struct DispatchPlan
+    {
+        internal readonly int GroupCount;
+        internal readonly int TailStart;
+        internal readonly int TailCount;
+
+        private DispatchPlan(int groupCount, int tailStart, int tailCount)
+        {
+            GroupCount = groupCount;
+            TailStart = tailStart;
+            TailCount = tailCount;
+        }
+
+        internal static DispatchPlan Create(int instanceCount, uint threadsPerGroup)
+        {
+            if (instanceCount < 0) throw new ArgumentOutOfRangeException(nameof(instanceCount));
+            if (threadsPerGroup == 0 || threadsPerGroup > int.MaxValue)
+                throw new ArgumentOutOfRangeException(nameof(threadsPerGroup));
+            var threads = (int)threadsPerGroup;
+            var groups = instanceCount / threads;
+            var start = groups * threads;
+            return new DispatchPlan(groups, start, instanceCount - start);
+        }
+
+        internal void FillTailIndices(uint[] destination)
+        {
+            if (destination == null) throw new ArgumentNullException(nameof(destination));
+            if (destination.Length < TailCount) throw new ArgumentException("Tail index buffer is too small.", nameof(destination));
+            for (var i = 0; i < TailCount; i++) destination[i] = (uint)(TailStart + i);
+        }
+    }
+}
