diff --git a/unity/sphereopt-bundle/Assets/Plugins/Editor/ExportAssetBundles/ExportAssetBundles.cs b/unity/sphereopt-bundle/Assets/Plugins/Editor/ExportAssetBundles/ExportAssetBundles.cs
index d1239dbae3c5e6690de282de4a12aab21d41846d..311f97a3641dae79dc6badd3f4a90e5875702695 100644
--- a/unity/sphereopt-bundle/Assets/Plugins/Editor/ExportAssetBundles/ExportAssetBundles.cs
+++ b/unity/sphereopt-bundle/Assets/Plugins/Editor/ExportAssetBundles/ExportAssetBundles.cs
@@ -4,6 +4,24 @@ using UnityEngine;
 
 public class ExportAssetBundles
 {
+    private static void Build(string path, BuildAssetBundleOptions options)
+    {
+        Directory.CreateDirectory(path);
+        // Importer labels live in .meta files, which this repository does not
+        // track. Explicit assets make a fresh-checkout build reproducible.
+        var assets = new[] { new AssetBundleBuild {
+            assetBundleName = "sphereopt-bundle",
+            assetNames = new[] {
+                "Assets/sphereopt-bundle/shaders/Dyson Shell Unlit Instanced.shader",
+                "Assets/sphereopt-bundle/shaders/Node Inst REPLACE.shader",
+                "Assets/sphereopt-bundle/shaders/Frame Inst REPLACE.shader",
+                "Assets/sphereopt-bundle/shaders/Frame LOD.compute"
+            }
+        } };
+        if (BuildPipeline.BuildAssetBundles(path, assets, options, BuildTarget.StandaloneWindows64) == null)
+            throw new System.InvalidOperationException("SphereOpt AssetBundle build failed.");
+    }
+
     [MenuItem("Window/DSP Tools/Build AssetBundles/Uncompressed")]
     public static void ExportResourceUncomp()
     {
@@ -11,7 +29,7 @@ public class ExportAssetBundles
         string filePath = Path.Combine(Application.streamingAssetsPath, folderName);
 
         //Build for Windows platform
-        BuildPipeline.BuildAssetBundles(filePath, BuildAssetBundleOptions.UncompressedAssetBundle, BuildTarget.StandaloneWindows64);
+        Build(filePath, BuildAssetBundleOptions.UncompressedAssetBundle);
 
         //Uncomment to build for other platforms
         //BuildPipeline.BuildAssetBundles(filePath, BuildAssetBundleOptions.None, BuildTarget.iOS);
@@ -30,7 +48,7 @@ public class ExportAssetBundles
         string filePath = Path.Combine(Application.streamingAssetsPath, folderName);
 
         //Build for Windows platform
-        BuildPipeline.BuildAssetBundles(filePath, BuildAssetBundleOptions.None, BuildTarget.StandaloneWindows64);
+        Build(filePath, BuildAssetBundleOptions.None);
 
         //Uncomment to build for other platforms
         //BuildPipeline.BuildAssetBundles(filePath, BuildAssetBundleOptions.None, BuildTarget.iOS);
