--- /dev/null
+++ b/tests/SphereOpt.Tests/GameAccessTests.cs
@@ -0,0 +1,69 @@
+using System.Reflection;
+using UnityEngine;
+
+namespace SphereOpt.Tests;
+
+internal static class GameAccessTests
+{
+    internal static IEnumerable<(string, Action)> Cases()
+    {
+        yield return ("GameAccess/fixture fields are private with exact types", () =>
+        {
+            AssertField(typeof(DysonShell), "polyn", typeof(VectorLF3[]));
+            AssertField(typeof(DysonShell), "clockwise", typeof(bool));
+            AssertField(typeof(DysonShell), "center", typeof(VectorLF3));
+            AssertField(typeof(DysonShell), "radius", typeof(double));
+            AssertField(typeof(DysonSphereSegmentRenderer), "instMats", typeof(Material[]));
+        });
+        yield return ("GameAccess/read all five fields on distinct fixtures", ReadFields);
+        yield return ("GameAccess/field refs alias private backing fields", FieldRefsAlias);
+    }
+
+    private static void AssertField(Type owner, string name, Type type)
+    {
+        var field = owner.GetField(name, BindingFlags.NonPublic | BindingFlags.Instance)
+            ?? throw new InvalidOperationException($"Missing private fixture field {owner.Name}.{name}");
+        Check.True(field.IsPrivate, $"{name} must exercise private access");
+        Check.Equal(type, field.FieldType, $"{name} type");
+    }
+
+    private static void ReadFields()
+    {
+        GameAccess.Validate();
+        var normals = new[] { new VectorLF3(1, -2, 3), new VectorLF3(4, 5, -6) };
+        var center = new VectorLF3(123.25, -456.5, 789.75);
+        var populated = new DysonShell(normals, true, center, 12_345.6789);
+        var empty = new DysonShell([], false, default, 0);
+        foreach (var shell in new[] { populated, empty })
+        {
+            var expected = shell.Snapshot();
+            Check.Same(expected.Normals, GameAccess.ShellNormals(shell), "Normal array identity");
+            Check.Equal(expected.Clockwise, GameAccess.ShellClockwise(shell), "Clockwise read");
+            Check.Equal(expected.Center, GameAccess.ShellCenter(shell), "Struct field read");
+            Check.Equal(expected.Radius, GameAccess.ShellRadius(shell), "Double field read");
+        }
+        var materials = new[] { new Material("one"), new Material("two") };
+        foreach (var renderer in new[] { new DysonSphereSegmentRenderer(materials), new DysonSphereSegmentRenderer([]) })
+            Check.Same(renderer.Snapshot(), GameAccess.SegmentMaterials(renderer), "Material array identity");
+    }
+
+    private static void FieldRefsAlias()
+    {
+        var shell = new DysonShell([], false, default, 0);
+        var normals = new[] { new VectorLF3(7, 8, 9) };
+        var center = new VectorLF3(-1, 2, -3);
+        GameAccess.ShellNormals(shell) = normals;
+        GameAccess.ShellClockwise(shell) = true;
+        GameAccess.ShellCenter(shell) = center;
+        GameAccess.ShellRadius(shell) = 123.5;
+        var actual = shell.Snapshot();
+        Check.Same(normals, actual.Normals, "Normal ref targets the backing field");
+        Check.True(actual.Clockwise, "Bool ref targets the backing field");
+        Check.Equal(center, actual.Center, "Struct ref targets the backing field");
+        Check.Equal(123.5, actual.Radius, "Double ref targets the backing field");
+        var renderer = new DysonSphereSegmentRenderer([]);
+        var materials = new[] { new Material("replacement") };
+        GameAccess.SegmentMaterials(renderer) = materials;
+        Check.Same(materials, renderer.Snapshot(), "Material ref targets the backing field");
+    }
+}
diff --git a/tests/SphereOpt.Tests/GameFixtures.cs b/tests/SphereOpt.Tests/GameFixtures.cs
new file mode 100644
index 0000000000000000000000000000000000000000..1ab56406184a89294c0eb7050985647dc1686f3a
--- /dev/null
+++ b/tests/SphereOpt.Tests/GameFixtures.cs
@@ -0,0 +1,39 @@
+// These are data-only fixtures. No game assemblies, Unity runtime, or plugin
+// initializers are referenced by this test project.
+namespace UnityEngine
+{
+    public sealed class Material
+    {
+        public Material(string name) => Name = name;
+        public string Name { get; }
+    }
+}
+
+public readonly record struct VectorLF3(double x, double y, double z);
+
+public sealed class DysonShell
+{
+    private VectorLF3[] polyn;
+    private bool clockwise;
+    private VectorLF3 center;
+    private double radius;
+
+    public DysonShell(VectorLF3[] normals, bool isClockwise, VectorLF3 position, double shellRadius)
+    {
+        polyn = normals;
+        clockwise = isClockwise;
+        center = position;
+        radius = shellRadius;
+    }
+
+    // Read the backing fields independently of Harmony for aliasing checks.
+    public (VectorLF3[] Normals, bool Clockwise, VectorLF3 Center, double Radius) Snapshot()
+        => (polyn, clockwise, center, radius);
+}
+
+public sealed class DysonSphereSegmentRenderer
+{
+    private UnityEngine.Material[] instMats;
+    public DysonSphereSegmentRenderer(UnityEngine.Material[] materials) => instMats = materials;
+    public UnityEngine.Material[] Snapshot() => instMats;
+}
diff --git a/tests/SphereOpt.Tests/PoolCompactionTests.cs b/tests/SphereOpt.Tests/PoolCompactionTests.cs
new file mode 100644
index 0000000000000000000000000000000000000000..9966a906f2a67bccd16d2aaf5ee07d9c9d5db583
--- /dev/null
+++ b/tests/SphereOpt.Tests/PoolCompactionTests.cs
@@ -0,0 +1,337 @@
+namespace SphereOpt.Tests;
+
+internal static class PoolCompactionTests
+{
+    internal static IEnumerable<(string Name, Action Run)> Cases()
+    {
+        foreach (var order in new[]
+        {
+            new[] { 50, 3, 90 }, new[] { 50, 90, 3 }, new[] { 3, 50, 90 },
+            new[] { 3, 90, 50 }, new[] { 90, 50, 3 }, new[] { 90, 3, 50 }
+        })
+        {
+            var captured = order;
+            yield return ($"PoolCompaction/remove order {string.Join(",", order)}", () => RemoveOrder(captured));
+        }
+        yield return ("PoolCompaction/independent pool ordering", IndependentPoolOrdering);
+        yield return ("PoolCompaction/empty allocation within removed span", EmptyAllocationWithinSpan);
+        yield return ("PoolCompaction/zero-size ranges remove without shifting peers", ZeroSizeRanges);
+        yield return ("PoolCompaction/missing and repeated removal preserve pools", MissingRemoval);
+        yield return ("PoolCompaction/explicit progress count owns exact range", ExplicitProgressCount);
+        yield return ("PoolCompaction/repeated registration preserves live allocation", RepeatedRegistration);
+        yield return ("PoolCompaction/removed reference tail is cleared", ClearReferences);
+        yield return ("PoolCompaction/invalid progress range leaves both pools intact", () => InvalidRange(true));
+        yield return ("PoolCompaction/invalid polygon range leaves both pools intact", () => InvalidRange(false));
+        yield return ("PoolCompaction/overlapping progress ranges rejected before mutation", () => Overlap(true));
+        yield return ("PoolCompaction/overlapping polygon ranges rejected before mutation", () => Overlap(false));
+        yield return ("PoolCompaction/invalid cursor leaves both pools intact", InvalidCursor);
+        yield return ("PoolCompaction/null second pool leaves first pool intact", NullPool);
+        yield return ("PoolCompaction/invalid registration rejected", InvalidRegistration);
+        yield return ("PoolCompaction/repeated regeneration reuses reclaimed capacity", Regeneration);
+        yield return ("PoolCompaction/randomized append remove matches independent model", RandomizedLifecycle);
+        yield return ("PoolCompaction/clear forgets all allocations", Clear);
+    }
+
+    private static void RemoveOrder(int[] order)
+    {
+        var fixture = new Fixture();
+        fixture.Add(50, 2, 3);
+        fixture.Add(3, 3, 1);
+        fixture.Add(90, 1, 2);
+        foreach (var id in order)
+        {
+            fixture.Remove(id);
+            fixture.Verify();
+            Check.True(!fixture.Compaction.TryGet(id, out _), "Removed shell remains registered");
+        }
+        Check.Equal(0, fixture.ProgressCursor, "Progress leak");
+        Check.Equal(0, fixture.PolygonCursor, "Polygon leak");
+        Check.True(fixture.Progress.All(value => value == 0), "Progress tail not cleared");
+        Check.True(fixture.Polygons.All(value => value == 0), "Polygon tail not cleared");
+    }
+
+    private static void IndependentPoolOrdering()
+    {
+        var compaction = new PoolCompaction();
+        var progress = new[] { 10, 11, 20, 0, 0 };
+        var polygons = new[] { 20, 21, 22, 10, 11, 0 };
+        var pc = 3;
+        var qc = 5;
+        compaction.Register(1, 0, 2, 3, 2);
+        compaction.Register(2, 2, 1, 0, 3);
+        Check.True(compaction.Remove(1, progress, ref pc, polygons, ref qc), "Missing removal");
+        Check.Sequence(new[] { 20, 0, 0, 0, 0 }, progress, "Progress order");
+        Check.Sequence(new[] { 20, 21, 22, 0, 0, 0 }, polygons, "Polygon order");
+        Check.True(compaction.TryGet(2, out var remaining), "Lost survivor");
+        Check.Equal(0, remaining.ProgressIndex, "Progress base");
+        Check.Equal(0, remaining.PolygonIndex, "Polygon base");
+    }
+
+    private static void EmptyAllocationWithinSpan()
+    {
+        var compaction = new PoolCompaction();
+        var progress = new[] { 1, 2, 3, 4, 5, 6, 0 };
+        var polygons = progress.ToArray();
+        var pc = 6;
+        var qc = 6;
+        compaction.Register(1, 1, 4, 1, 4);
+        compaction.Register(2, 3, 0, 3, 0);
+        compaction.Register(3, 5, 1, 5, 1);
+        compaction.Remove(1, progress, ref pc, polygons, ref qc);
+        Check.True(compaction.TryGet(2, out var empty), "Empty allocation disappeared");
+        Check.Equal(1, empty.ProgressIndex, "Empty progress base");
+        Check.Equal(1, empty.PolygonIndex, "Empty polygon base");
+        Check.True(compaction.TryGet(3, out var tail), "Tail disappeared");
+        Check.Equal(1, tail.ProgressIndex, "Tail progress base");
+        Check.Equal(1, tail.PolygonIndex, "Tail polygon base");
+        Check.Sequence(new[] { 1, 6, 0, 0, 0, 0, 0 }, progress, "Empty-range compaction");
+        Check.True(compaction.Remove(2, progress, ref pc, polygons, ref qc), "Empty shell not removable");
+        Check.Equal(2, pc, "Removing empty progress shifted cursor");
+        Check.Equal(2, qc, "Removing empty polygon shifted cursor");
+    }
+
+    private static void ZeroSizeRanges()
+    {
+        var fixture = new Fixture();
+        fixture.Add(1, 0, 2);
+        fixture.Add(2, 3, 0);
+        fixture.Add(3, 0, 0);
+        fixture.Add(4, 1, 1);
+        foreach (var id in new[] { 3, 1, 2, 4 })
+        {
+            fixture.Remove(id);
+            fixture.Verify();
+        }
+    }
+
+    private static void MissingRemoval()
+    {
+        var fixture = new Fixture();
+        fixture.Add(2, 3, 2);
+        foreach (var id in new[] { -1, 0, 99, int.MaxValue })
+            Check.True(!fixture.Compaction.Remove(id, fixture.Progress, ref fixture.ProgressCursor,
+                fixture.Polygons, ref fixture.PolygonCursor), "Unknown removal succeeded");
+        fixture.Verify();
+        fixture.Remove(2);
+        Check.True(!fixture.Compaction.Remove(2, fixture.Progress, ref fixture.ProgressCursor,
+            fixture.Polygons, ref fixture.PolygonCursor), "Repeated removal succeeded");
+        fixture.Verify();
+    }
+
+    private static void ExplicitProgressCount()
+    {
+        var compaction = new PoolCompaction();
+        var progress = new[] { 10, 11, 20, 21, 0 };
+        var polygons = new[] { 10, 20, 0 };
+        var pc = 4;
+        var qc = 2;
+        compaction.Register(1, 0, 4, 0, 1);
+        compaction.RegisterProgressCount(1, 2);
+        compaction.Register(2, 2, 2, 1, 1);
+        compaction.RegisterProgressCount(99, 4);
+        compaction.Remove(1, progress, ref pc, polygons, ref qc);
+        Check.Sequence(new[] { 20, 21, 0, 0, 0 }, progress, "Explicit count removed another shell");
+        Check.Equal(2, pc, "Explicit progress count");
+    }
+
+    private static void ClearReferences()
+    {
+        var compaction = new PoolCompaction();
+        var progress = new string?[] { "a", "b", "c", null, "guard" };
+        var polygons = new object?[] { new object(), new object(), null, "guard" };
+        var survivor = polygons[1];
+        var pc = 3;
+        var qc = 2;
+        compaction.Register(1, 0, 2, 0, 1);
+        compaction.Register(2, 2, 1, 1, 1);
+        compaction.Remove(1, progress, ref pc, polygons, ref qc);
+        Check.Sequence(new string?[] { "c", null, null, null, "guard" }, progress, "Progress references/guard");
+        Check.Sequence(new object?[] { survivor, null, null, "guard" }, polygons, "Polygon references/guard");
+    }
+
+    private static void RepeatedRegistration()
+    {
+        var fixture = new Fixture();
+        fixture.Add(1, 2, 1);
+        fixture.Add(2, 3, 2);
+        var original = fixture.Compaction.Register(1, 0, fixture.ProgressCursor, 0, 1);
+        Check.Equal(2, original.ProgressCount, "Appearance update enlarged original progress range");
+        fixture.Remove(1);
+        fixture.Verify();
+        // Reusing the released shell ID registers a new allocation at the current tail.
+        fixture.Add(1, 1, 3);
+        fixture.Verify();
+        fixture.Remove(2);
+        fixture.Verify();
+    }
+
+    private static void InvalidRange(bool progressInvalid)
+    {
+        var fixture = new Fixture();
+        fixture.Add(1, 2, 2);
+        fixture.Compaction.Register(2, 2, progressInvalid ? 2 : 0, 2, progressInvalid ? 0 : 2);
+        ExpectUnchanged<InvalidOperationException>(fixture, 1);
+    }
+
+    private static void Overlap(bool progressOverlap)
+    {
+        var fixture = new Fixture();
+        fixture.Add(1, 3, 3);
+        fixture.ProgressCursor = 5;
+        fixture.PolygonCursor = 5;
+        fixture.Compaction.Register(2, progressOverlap ? 2 : 3, 2, progressOverlap ? 3 : 2, 2);
+        ExpectUnchanged<InvalidOperationException>(fixture, 1);
+    }
+
+    private static void InvalidCursor()
+    {
+        var fixture = new Fixture();
+        fixture.Add(1, 2, 2);
+        fixture.PolygonCursor = fixture.Polygons.Length + 1;
+        ExpectUnchanged<ArgumentOutOfRangeException>(fixture, 1);
+        fixture.PolygonCursor = 2;
+        fixture.ProgressCursor = -1;
+        ExpectUnchanged<ArgumentOutOfRangeException>(fixture, 1);
+    }
+
+    private static void InvalidRegistration()
+    {
+        var compaction = new PoolCompaction();
+        Check.Throws<ArgumentOutOfRangeException>(() => compaction.Register(-1, 0, 0, 0, 0), "shellId");
+        Check.Throws<ArgumentOutOfRangeException>(() => compaction.Register(1, -1, 0, 0, 0), "progressIndex");
+        Check.Throws<ArgumentOutOfRangeException>(() => compaction.Register(1, 0, -1, 0, 0), "progressCount");
+        Check.Throws<ArgumentOutOfRangeException>(() => compaction.Register(1, 0, 0, -1, 0), "polygonIndex");
+        Check.Throws<ArgumentOutOfRangeException>(() => compaction.Register(1, 0, 0, 0, -1), "polygonCount");
+        Check.Throws<ArgumentOutOfRangeException>(() => compaction.Register(1, int.MaxValue, 1, 0, 0), "progressCount");
+        Check.Throws<ArgumentOutOfRangeException>(() => compaction.Register(1, 0, 0, int.MaxValue, 1), "polygonCount");
+        Check.Throws<ArgumentOutOfRangeException>(() => compaction.RegisterProgressCount(1, -1), "count");
+        Check.Equal(0, compaction.Allocations.Count(), "Invalid registration changed ownership");
+    }
+
+    private static void NullPool()
+    {
+        var fixture = new Fixture();
+        fixture.Add(1, 2, 2);
+        var progress = fixture.Progress.ToArray();
+        Check.Throws<ArgumentNullException>(() => fixture.Compaction.Remove<int, int>(1, fixture.Progress,
+            ref fixture.ProgressCursor, null!, ref fixture.PolygonCursor), "polygonPool");
+        Check.Sequence(progress, fixture.Progress, "Null second pool changed first pool");
+        fixture.Verify();
+    }
+
+    private static void Regeneration()
+    {
+        var fixture = new Fixture();
+        fixture.Add(9, 3, 4);
+        fixture.Add(2, 2, 3);
+        for (var iteration = 0; iteration < 500; iteration++)
+        {
+            fixture.Remove(9);
+            fixture.Add(9, iteration % 7, iteration % 5);
+            fixture.Verify();
+            Check.True(fixture.ProgressCursor <= 8, "Progress cursor grows across regeneration");
+            Check.True(fixture.PolygonCursor <= 7, "Polygon cursor grows across regeneration");
+        }
+    }
+
+    private static void RandomizedLifecycle()
+    {
+        var random = new Random(21891);
+        var fixture = new Fixture();
+        for (var step = 0; step < 2000; step++)
+        {
+            var id = random.Next(1, 25);
+            if (fixture.Live.Any(shell => shell.Id == id)) fixture.Remove(id);
+            else fixture.Add(id, random.Next(0, 8), random.Next(0, 6));
+            fixture.Verify();
+        }
+        foreach (var id in fixture.Live.Select(shell => shell.Id).ToArray()) fixture.Remove(id);
+        fixture.Verify();
+        Check.Equal(0, fixture.ProgressCursor, "Random sequence leaked progress");
+        Check.Equal(0, fixture.PolygonCursor, "Random sequence leaked polygons");
+    }
+
+    private static void Clear()
+    {
+        var fixture = new Fixture();
+        fixture.Add(1, 2, 2);
+        fixture.Compaction.Clear();
+        fixture.Compaction.Clear();
+        Check.Equal(0, fixture.Compaction.Allocations.Count(), "Clear retained allocations");
+        Check.True(!fixture.Compaction.TryGet(1, out _), "Clear retained shell");
+    }
+
+    private static void ExpectUnchanged<T>(Fixture fixture, int shellId) where T : Exception
+    {
+        var progress = fixture.Progress.ToArray();
+        var polygons = fixture.Polygons.ToArray();
+        var allocations = fixture.Compaction.Allocations.OrderBy(entry => entry.Key).ToArray();
+        var pc = fixture.ProgressCursor;
+        var qc = fixture.PolygonCursor;
+        Check.Throws<T>(() => fixture.Compaction.Remove(shellId, fixture.Progress, ref fixture.ProgressCursor,
+            fixture.Polygons, ref fixture.PolygonCursor));
+        Check.Sequence(progress, fixture.Progress, "Failed removal changed progress");
+        Check.Sequence(polygons, fixture.Polygons, "Failed removal changed polygons");
+        Check.Equal(pc, fixture.ProgressCursor, "Failed removal changed progress cursor");
+        Check.Equal(qc, fixture.PolygonCursor, "Failed removal changed polygon cursor");
+        Check.Sequence(allocations, fixture.Compaction.Allocations.OrderBy(entry => entry.Key), "Failed removal changed allocations");
+    }
+
+    private sealed record ModelShell(int Id, int[] Progress, int[] Polygons);
+
+    private sealed class Fixture
+    {
+        internal readonly PoolCompaction Compaction = new();
+        internal readonly int[] Progress = new int[256];
+        internal readonly int[] Polygons = new int[256];
+        internal readonly List<ModelShell> Live = new();
+        internal int ProgressCursor;
+        internal int PolygonCursor;
+        private int nextValue = 1;
+
+        internal void Add(int id, int progressCount, int polygonCount)
+        {
+            var progress = Enumerable.Range(nextValue, progressCount).ToArray();
+            nextValue += progressCount;
+            var polygons = Enumerable.Range(nextValue, polygonCount).ToArray();
+            nextValue += polygonCount;
+            Compaction.Register(id, ProgressCursor, progressCount, PolygonCursor, polygonCount);
+            progress.CopyTo(Progress, ProgressCursor);
+            polygons.CopyTo(Polygons, PolygonCursor);
+            ProgressCursor += progressCount;
+            PolygonCursor += polygonCount;
+            Live.Add(new ModelShell(id, progress, polygons));
+        }
+
+        internal void Remove(int id)
+        {
+            Check.True(Compaction.Remove(id, Progress, ref ProgressCursor, Polygons, ref PolygonCursor), "Live removal failed");
+            Live.RemoveAll(shell => shell.Id == id);
+        }
+
+        internal void Verify()
+        {
+            Check.Equal(Live.Count, Compaction.Allocations.Count(), "Live ownership count");
+            var expectedProgress = Live.SelectMany(shell => shell.Progress).ToArray();
+            var expectedPolygons = Live.SelectMany(shell => shell.Polygons).ToArray();
+            Check.Equal(expectedProgress.Length, ProgressCursor, "Progress cursor");
+            Check.Equal(expectedPolygons.Length, PolygonCursor, "Polygon cursor");
+            Check.Sequence(expectedProgress, Progress.Take(ProgressCursor), "Progress payload changed");
+            Check.Sequence(expectedPolygons, Polygons.Take(PolygonCursor), "Polygon payload changed");
+            Check.True(Progress.Skip(ProgressCursor).All(value => value == 0), "Dead progress not cleared");
+            Check.True(Polygons.Skip(PolygonCursor).All(value => value == 0), "Dead polygons not cleared");
+            var progressBase = 0;
+            var polygonBase = 0;
+            foreach (var shell in Live)
+            {
+                Check.True(Compaction.TryGet(shell.Id, out var allocation), "Live shell missing");
+                Check.Equal(progressBase, allocation.ProgressIndex, "Rebased progress offset");
+                Check.Equal(polygonBase, allocation.PolygonIndex, "Rebased polygon offset");
+                Check.Equal(shell.Progress.Length, allocation.ProgressCount, "Progress count changed");
+                Check.Equal(shell.Polygons.Length, allocation.PolygonCount, "Polygon count changed");
+                progressBase += shell.Progress.Length;
+                polygonBase += shell.Polygons.Length;
+            }
+        }
+    }
+}
diff --git a/tests/SphereOpt.Tests/Program.cs b/tests/SphereOpt.Tests/Program.cs
new file mode 100644
