new file mode 100644
index 0000000000000000000000000000000000000000..923c20c58a37a6036d99c9e2369b09155c921e29
--- /dev/null
+++ b/PoolCompaction.cs
@@ -0,0 +1,128 @@
+using System;
+using System.Collections.Generic;
+
+namespace SphereOpt
+{
+    // Tracks the CPU allocations without depending on Unity or GPU resources.
+    internal sealed class PoolCompaction
+    {
+        internal readonly struct Allocation
+        {
+            internal readonly int ProgressIndex;
+            internal readonly int ProgressCount;
+            internal readonly int PolygonIndex;
+            internal readonly int PolygonCount;
+
+            internal Allocation(int progressIndex, int progressCount, int polygonIndex, int polygonCount)
+            {
+                ProgressIndex = progressIndex;
+                ProgressCount = progressCount;
+                PolygonIndex = polygonIndex;
+                PolygonCount = polygonCount;
+            }
+        }
+
+        private readonly Dictionary<int, Allocation> allocations = new Dictionary<int, Allocation>();
+
+        internal IEnumerable<KeyValuePair<int, Allocation>> Allocations => allocations;
+
+        internal bool TryGet(int shellId, out Allocation allocation) => allocations.TryGetValue(shellId, out allocation);
+
+        internal Allocation Register(int shellId, int progressIndex, int progressCount, int polygonIndex, int polygonCount)
+        {
+            if (shellId < 0) throw new ArgumentOutOfRangeException(nameof(shellId));
+            ValidateAllocation(progressIndex, progressCount, nameof(progressIndex), nameof(progressCount));
+            ValidateAllocation(polygonIndex, polygonCount, nameof(polygonIndex), nameof(polygonCount));
+            // AddShellData may update appearance after other shells have been appended.
+            // A live shell retains its allocation until Remove explicitly releases it.
+            if (allocations.TryGetValue(shellId, out var existing)) return existing;
+            var allocation = new Allocation(progressIndex, progressCount, polygonIndex, polygonCount);
+            allocations.Add(shellId, allocation);
+            return allocation;
+        }
+
+        internal void RegisterProgressCount(int shellId, int count)
+        {
+            if (count < 0) throw new ArgumentOutOfRangeException(nameof(count));
+            if (!allocations.TryGetValue(shellId, out var allocation)) return;
+            ValidateAllocation(allocation.ProgressIndex, count, nameof(allocation.ProgressIndex), nameof(count));
+            allocations[shellId] = new Allocation(allocation.ProgressIndex, count, allocation.PolygonIndex, allocation.PolygonCount);
+        }
+
+        internal bool Remove<TProgress, TPolygon>(int shellId,
+            TProgress[] progressPool, ref int progressCursor, TPolygon[] polygonPool, ref int polygonCursor)
+        {
+            if (!allocations.TryGetValue(shellId, out var removed)) return false;
+
+            // Validate both pools and every surviving range before changing either pool.
+            ValidatePool(progressPool, progressCursor, nameof(progressPool), nameof(progressCursor));
+            ValidatePool(polygonPool, polygonCursor, nameof(polygonPool), nameof(polygonCursor));
+            ValidateRange(removed.ProgressIndex, removed.ProgressCount, progressCursor);
+            ValidateRange(removed.PolygonIndex, removed.PolygonCount, polygonCursor);
+            foreach (var entry in allocations)
+            {
+                if (entry.Key == shellId) continue;
+                var allocation = entry.Value;
+                ValidateRange(allocation.ProgressIndex, allocation.ProgressCount, progressCursor);
+                ValidateRange(allocation.PolygonIndex, allocation.PolygonCount, polygonCursor);
+                RejectOverlap(allocation.ProgressIndex, allocation.ProgressCount, removed.ProgressIndex, removed.ProgressCount);
+                RejectOverlap(allocation.PolygonIndex, allocation.PolygonCount, removed.PolygonIndex, removed.PolygonCount);
+            }
+
+            var liveIds = new List<int>(allocations.Keys);
+            Compact(progressPool, ref progressCursor, removed.ProgressIndex, removed.ProgressCount);
+            Compact(polygonPool, ref polygonCursor, removed.PolygonIndex, removed.PolygonCount);
+            allocations.Remove(shellId);
+            foreach (var id in liveIds)
+            {
+                if (id == shellId) continue;
+                var allocation = allocations[id];
+                allocations[id] = new Allocation(
+                    Rebase(allocation.ProgressIndex, removed.ProgressIndex, removed.ProgressCount), allocation.ProgressCount,
+                    Rebase(allocation.PolygonIndex, removed.PolygonIndex, removed.PolygonCount), allocation.PolygonCount);
+            }
+            return true;
+        }
+
+        internal void Clear() => allocations.Clear();
+
+        private static void ValidateAllocation(int index, int count, string indexName, string countName)
+        {
+            if (index < 0) throw new ArgumentOutOfRangeException(indexName);
+            if (count < 0 || (long)index + count > int.MaxValue) throw new ArgumentOutOfRangeException(countName);
+        }
+
+        private static void ValidatePool<T>(T[] pool, int cursor, string poolName, string cursorName)
+        {
+            if (pool == null) throw new ArgumentNullException(poolName);
+            if (cursor < 0 || cursor > pool.Length) throw new ArgumentOutOfRangeException(cursorName);
+        }
+
+        private static void ValidateRange(int index, int count, int cursor)
+        {
+            if (index > cursor || count > cursor - index)
+                throw new InvalidOperationException("Shell allocation exceeds its pool cursor.");
+        }
+
+        private static void RejectOverlap(int index, int count, int removedIndex, int removedCount)
+        {
+            if (count != 0 && removedCount != 0 && index < removedIndex + removedCount && removedIndex < index + count)
+                throw new InvalidOperationException("Shell allocations overlap.");
+        }
+
+        private static void Compact<T>(T[] pool, ref int cursor, int index, int count)
+        {
+            if (count == 0) return;
+            Array.Copy(pool, index + count, pool, index, cursor - index - count);
+            cursor -= count;
+            Array.Clear(pool, cursor, count);
+        }
+
+        private static int Rebase(int index, int removedIndex, int removedCount)
+        {
+            if (index >= removedIndex + removedCount) return index - removedCount;
+            // An empty allocation can sit inside the removed span.
+            return index > removedIndex ? removedIndex : index;
+        }
+    }
+}
