@@ -0,0 +1,166 @@
+namespace SphereOpt.Tests;
+
+internal static class ShellBatchPolicyTests
+{
+    internal static IEnumerable<(string, Action)> Cases()
+    {
+        (string Name, double X, double Y, double Z)[] poles =
+        [
+            ("+X", 1, 0, 0), ("-X", -1, 0, 0),
+            ("+Y", 0, 1, 0), ("-Y", 0, -1, 0),
+            ("+Z", 0, 0, 1), ("-Z", 0, 0, -1)
+        ];
+        foreach (var pole in poles)
+            yield return ($"ShellBatchPolicy/valid {pole.Name} pole", () =>
+                ExpectCenter(true, pole.X, pole.Y, pole.Z, pole.Name));
+
+        yield return ("ShellBatchPolicy/zero center", () => ExpectCenter(false, 0, 0, 0, "Zero center"));
+        yield return ("ShellBatchPolicy/signed zero center", () =>
+            ExpectCenter(false, -0.0, 0.0, -0.0, "Signed zero center"));
+
+        foreach (var invalid in new[] { double.NaN, double.PositiveInfinity, double.NegativeInfinity })
+        {
+            yield return ($"ShellBatchPolicy/nonfinite X={invalid}", () =>
+                ExpectCenter(false, invalid, 2, 3, "Nonfinite X"));
+            yield return ($"ShellBatchPolicy/nonfinite Y={invalid}", () =>
+                ExpectCenter(false, 2, invalid, 3, "Nonfinite Y"));
+            yield return ($"ShellBatchPolicy/nonfinite Z={invalid}", () =>
+                ExpectCenter(false, 2, 3, invalid, "Nonfinite Z"));
+        }
+
+        // The repaired, hash-pinned bundle supports both cardinal poles and the
+        // nearby directions that previously needed conservative exclusions.
+        foreach (var transverse in new[] { double.Epsilon, 0.0007, 0.0008, 0.000999999,
+                     0.001, 0.001000001, 0.00105, 0.001099999, 0.0011, 0.001100001 })
+            yield return ($"ShellBatchPolicy/valid near poles transverse={transverse:R}", () =>
+                NearPoles(transverse));
+
+        foreach (var radius in new[] { 1e-160, 0.0001, 0.125, 12_345.6789, 1_000_000.0, 1e150 })
+            yield return ($"ShellBatchPolicy/valid directions at radius={radius:R}", () => AtRadius(radius));
+
+        yield return ("ShellBatchPolicy/finite subnormal components beside a valid pole", () =>
+        {
+            ExpectCenter(true, 1, double.Epsilon, -double.Epsilon, "Tiny transverse components beside X");
+            ExpectCenter(true, double.Epsilon, 1, -double.Epsilon, "Tiny transverse components beside Y");
+            ExpectCenter(true, double.Epsilon, -double.Epsilon, 1, "Tiny transverse components beside Z");
+        });
+        yield return ("ShellBatchPolicy/subnormal components whose squares underflow", () =>
+            ExpectCenter(false, double.Epsilon, -double.Epsilon, double.Epsilon, "Squared length underflows to zero"));
+        yield return ("ShellBatchPolicy/normal finite components whose squares underflow", () =>
+            ExpectCenter(false, 1e-200, -2e-200, 3e-200, "Nonzero finite input can have zero squared length"));
+        yield return ("ShellBatchPolicy/finite component whose square overflows in any coordinate", () =>
+        {
+            ExpectCenter(false, double.MaxValue, 2, 3, "X square overflows");
+            ExpectCenter(false, 2, -double.MaxValue, 3, "Y square overflows");
+            ExpectCenter(false, 2, 3, double.MaxValue, "Z square overflows");
+        });
+        yield return ("ShellBatchPolicy/finite squares whose sum overflows", () =>
+            ExpectCenter(false, 1e154, -1e154, 1e154, "Individual finite squares do not ensure finite squared length"));
+
+        foreach (var test in ProgressCases()) yield return test;
+    }
+
+    private static IEnumerable<(string, Action)> ProgressCases()
+    {
+        (string Name, int Points, int Start, int End, int PerVertex, bool Valid, float Progress)[] cases =
+        [
+            ("negative points", -1, 3, 11, 10, false, 0f),
+            ("minimum points", int.MinValue, 3, 11, 10, false, 0f),
+            ("zero points", 0, 3, 11, 10, true, 0f),
+            ("first point", 1, 3, 11, 10, true, 0.0125f),
+            ("partial points", 40, 3, 11, 10, true, 0.5f),
+            ("one point before completion", 79, 3, 11, 10, true, 0.9875f),
+            ("final point", 80, 3, 11, 10, true, 1f),
+            ("one excess point", 81, 3, 11, 10, true, 1f),
+            ("maximum excess points", int.MaxValue, 3, 11, 10, true, 1f),
+            ("negative start", 40, -1, 11, 10, false, 0f),
+            ("minimum start cannot overflow range subtraction", int.MaxValue, int.MinValue, int.MaxValue, 1, false, 0f),
+            ("negative end", 40, 0, -1, 10, false, 0f),
+            ("minimum end", 40, 0, int.MinValue, 10, false, 0f),
+            ("zero span", 40, 0, 0, 10, false, 0f),
+            ("equal nonzero bounds", 40, 7, 7, 10, false, 0f),
+            ("reversed bounds", 40, 11, 3, 10, false, 0f),
+            ("zero points per vertex", 40, 3, 11, 0, false, 0f),
+            ("negative points per vertex", 40, 3, 11, -1, false, 0f),
+            ("minimum points per vertex", 40, 3, 11, int.MinValue, false, 0f),
+            ("single vertex unbuilt", 0, 0, 1, 1, true, 0f),
+            ("single vertex final point", 1, 0, 1, 1, true, 1f),
+            ("single vertex excess points", 2, 0, 1, 1, true, 1f),
+            ("large offset partial points", 40, int.MaxValue - 8, int.MaxValue, 10, true, 0.5f),
+            ("large offset final point", 80, int.MaxValue - 8, int.MaxValue, 10, true, 1f),
+            ("largest int capacity final point", int.MaxValue, int.MaxValue - 1, int.MaxValue, int.MaxValue, true, 1f),
+            ("capacity exceeds signed int range", 1_250_000_000, 0, 50_000, 50_000, true, 0.5f),
+            ("capacity twice maximum int", int.MaxValue, 0, int.MaxValue, 2, true, 0.5f),
+            ("capacity product would wrap to zero in int", 1_073_741_824, 0, 65_536, 65_536, true, 0.25f),
+            ("largest long capacity remains partial", int.MaxValue, 0, int.MaxValue, int.MaxValue, true, 4.656613e-10f),
+            ("zero points with largest long capacity", 0, 0, int.MaxValue, int.MaxValue, true, 0f)
+        ];
+        foreach (var test in cases)
+            yield return ($"ShellBatchPolicy/progress {test.Name}", () =>
+            {
+                Check.Equal(test.Valid, global::SphereOpt.ShellBatchPolicy.HasValidProgress(
+                    test.Points, test.Start, test.End, test.PerVertex, 0.5f), test.Name);
+                var actual = global::SphereOpt.ShellBatchPolicy.GetProgress(
+                    test.Points, test.Start, test.End, test.PerVertex);
+                Check.Equal(test.Progress, actual, test.Name);
+                Check.True(float.IsFinite(actual) && actual >= 0f && actual <= 1f,
+                    "Progress must remain finite and clamped");
+            });
+
+        foreach (var fill in new[] { 0f, -0.0f, float.Epsilon, 0.5f, MathF.BitDecrement(1f), 1f })
+            yield return ($"ShellBatchPolicy/valid fill={fill:R} at every construction stage", () =>
+            {
+                foreach (var points in new[] { 0, 1, 40, 79, 80, 81, int.MaxValue })
+                    Check.True(global::SphereOpt.ShellBatchPolicy.HasValidProgress(points, 3, 11, 10, fill),
+                        $"Valid fill must accept zero, partial, completed and excess points: points={points}");
+            });
+
+        foreach (var fill in new[] { float.NaN, float.PositiveInfinity, float.NegativeInfinity,
+                     -float.Epsilon, MathF.BitIncrement(1f), float.MinValue, float.MaxValue })
+            yield return ($"ShellBatchPolicy/invalid fill={fill:R}", () =>
+            {
+                foreach (var points in new[] { 0, 40, 80, 81 })
+                    Check.True(!global::SphereOpt.ShellBatchPolicy.HasValidProgress(points, 3, 11, 10, fill),
+                        "Every construction stage must reject nonfinite or out-of-range fill");
+            });
+    }
+
+    private static void NearPoles(double transverse)
+    {
+        var axial = Math.Sqrt(1 - 2 * transverse * transverse);
+        foreach (var xSign in new[] { -1, 1 })
+        foreach (var ySign in new[] { -1, 1 })
+        foreach (var zSign in new[] { -1, 1 })
+        {
+            ExpectCenter(true, xSign * axial, ySign * transverse, zSign * transverse, "Near X pole");
+            ExpectCenter(true, xSign * transverse, ySign * axial, zSign * transverse, "Near Y pole");
+            ExpectCenter(true, xSign * transverse, ySign * transverse, zSign * axial, "Near Z pole");
+            ExpectCenter(true, xSign * transverse, ySign * axial, 0, "Y pole approached along X");
+            ExpectCenter(true, 0, ySign * axial, zSign * transverse, "Y pole approached along Z");
+            ExpectCenter(true, xSign * transverse, 0, zSign * axial, "Z pole approached along X");
+            ExpectCenter(true, 0, ySign * transverse, zSign * axial, "Z pole approached along Y");
+        }
+    }
+
+    private static void AtRadius(double radius)
+    {
+        (double X, double Y, double Z)[] directions = [(3, 4, 12), (12, 3, 4), (4, 12, 3)];
+        foreach (var direction in directions)
+        foreach (var xSign in new[] { -1, 1 })
+        foreach (var ySign in new[] { -1, 1 })
+        foreach (var zSign in new[] { -1, 1 })
+            ExpectCenter(true, xSign * radius * direction.X / 13, ySign * radius * direction.Y / 13,
+                zSign * radius * direction.Z / 13, "Rotated direction at arbitrary radius");
+
+        foreach (var sign in new[] { -1, 1 })
+        {
+            ExpectCenter(true, sign * radius, 0, 0, "Scaled X pole");
+            ExpectCenter(true, 0, sign * radius, 0, "Scaled Y pole");
+            ExpectCenter(true, 0, 0, sign * radius, "Scaled Z pole");
+        }
+    }
+
+    private static void ExpectCenter(bool valid, double x, double y, double z, string context)
+        => Check.Equal(valid, global::SphereOpt.ShellBatchPolicy.HasValidCenter(x, y, z),
+            $"{context}: center=({x:R}, {y:R}, {z:R})");
+}
diff --git a/tests/SphereOpt.Tests/ShellCursorRewriterTests.cs b/tests/SphereOpt.Tests/ShellCursorRewriterTests.cs
new file mode 100644
index 0000000000000000000000000000000000000000..461e5cc9b24bd76cd2125f15c528f8451b3e5627
--- /dev/null
+++ b/tests/SphereOpt.Tests/ShellCursorRewriterTests.cs
@@ -0,0 +1,571 @@
+using System.Reflection;
+using System.Reflection.Emit;
+using HarmonyLib;
+
+namespace SphereOpt.Tests;
+
+internal static class ShellCursorRewriterTests
+{
+    private const int Canary = 0x24681357;
+    private static readonly FieldInfo Cursor = Field<LayerFixture>(nameof(LayerFixture.shellCursor));
+    private static readonly MethodInfo Getter = Method(nameof(RenderCursor));
+
+    internal static IEnumerable<(string, Action)> Cases()
+    {
+        foreach (var counter in new[] { 0, 10, 40, 41, 50 })
+        {
+            var value = counter;
+            yield return ($"ShellCursor/executable fallback preserves shell loop counter={value}",
+                () => Fallback(value));
+            yield return ($"ShellCursor/executable batching skips shells only counter={value}",
+                () => Batched(value));
+        }
+        yield return ("ShellCursor/executable mixed batched and fallback layers", MixedLayers);
+        foreach (var batched in new[] { false, true })
+        foreach (var counter in new[] { 0, 1 })
+        {
+            var handled = batched;
+            var value = counter;
+            yield return ($"ShellCursor/executable empty cursor=1 batch={handled} counter={value}",
+                () => EmptyLayer(handled, value));
+        }
+        yield return ("ShellCursor/executable invalid zero cursor retains fallback modulo failure", ZeroCursorFallback);
+        yield return ("ShellCursor/executable batched zero cursor uses nonzero modulo denominator", ZeroCursorBatched);
+        yield return ("ShellCursor/executable zero cursor on non-refresh frame bypasses modulo", ZeroCursorNonRefresh);
+        yield return ("ShellCursor/executable getter consumes receiver and preserves stack values", StackContract);
+        yield return ("ShellCursor/executable try catch finally normal path", () => ExceptionRegions(false));
+        yield return ("ShellCursor/executable try catch finally exceptional path", () => ExceptionRegions(true));
+        yield return ("ShellCursor/metadata exact field identity and input ownership", MetadataAndInputOwnership);
+        foreach (var count in new[] { 0, 1, 3 })
+        {
+            var matches = count;
+            yield return ($"ShellCursor/{matches} matches refused without changing originals", () => RefuseMatchCount(matches));
+        }
+        yield return ("ShellCursor/repeated rewrite refused without changing prior result", RepeatedRewrite);
+        yield return ("ShellCursor/null arguments rejected", NullArguments);
+    }
+
+    private static void Fallback(int counter)
+    {
+        var original = CompileLoop(false);
+        var rewritten = CompileLoop(true);
+        var baseline = Frame(counter, SparseLayer(2, false));
+        var actual = Frame(counter, SparseLayer(2, false));
+        Check.Equal(Canary, original(baseline), "Original continuation");
+        Check.Equal(Canary, rewritten(actual), "Rewritten continuation");
+        AssertSameFrame(baseline, actual);
+        Check.Sequence(new[] { (2, 1), (2, 4), (2, 5) }, actual.ShellDraws,
+            "Fallback must draw every live shell, ignoring null slots and mismatched IDs");
+        Check.Sequence(actual.ShellDraws, actual.DynamicUpdates, "Every live shell retains its dynamic update");
+        var expectedStatic = counter switch
+        {
+            10 => new[] { (2, 1) },
+            40 => new[] { (2, 4) },
+            50 => new[] { (2, 5) },
+            _ => Array.Empty<(int, int)>()
+        };
+        Check.Sequence(expectedStatic, actual.StaticUpdates, "Captured modulo selects the material refresh shell");
+        Check.Equal(counter % 10 == 0 ? 7 : 6, actual.Layers[0].GetterCalls,
+            "Getter must serve the modulo denominator and every loop-bound evaluation");
+        AssertOutsideShellLoop(actual, counter, [2]);
+        AssertFixtureFields(actual);
+    }
+
+    private static void Batched(int counter)
+    {
+        var original = CompileLoop(false);
+        var rewritten = CompileLoop(true);
+        var baseline = Frame(counter, SparseLayer(2, true));
+        var actual = Frame(counter, SparseLayer(2, true));
+        Check.Equal(Canary, original(baseline), "Original continuation");
+        Check.Equal(Canary, rewritten(actual), "Rewritten continuation");
+        Check.Equal(3, baseline.ShellDraws.Count, "Unrewritten control must reach shell draws");
+        Check.Equal(0, actual.ShellDraws.Count, "Handled layer must skip original shell draws");
+        Check.Equal(0, actual.StaticUpdates.Count, "Handled layer must skip original static updates");
+        Check.Equal(0, actual.DynamicUpdates.Count, "Handled layer must skip original dynamic updates");
+        Check.Equal(counter % 10 == 0 ? 2 : 1, actual.Layers[0].GetterCalls,
+            "Cursor=1 must avoid modulo zero while making the first loop condition false");
+        AssertOutsideShellLoop(actual, counter, [2]);
+        Check.Equal(baseline.NodeDraws, actual.NodeDraws, "Node draws changed");
+        Check.Equal(baseline.FrameDraws, actual.FrameDraws, "Frame draws changed");
+        Check.Sequence(baseline.OverlayLayers, actual.OverlayLayers, "Painting overlays changed");
+        Check.Sequence(baseline.AdjacentReads, actual.AdjacentReads, "Unrelated field reads changed");
+        AssertFixtureFields(actual);
+    }
+
+    private static void MixedLayers()
+    {
+        var rewritten = CompileLoop(true);
+        var frame = Frame(10, SparseLayer(1, true), new LayerFixture(2, 4, false), new LayerFixture(3, 2, true));
+        Check.Equal(Canary, rewritten(frame), "Original continuation");
+        Check.Sequence(new[] { (2, 1), (2, 2), (2, 3) }, frame.ShellDraws,
+            "A handled layer must not suppress a neighboring fallback layer");
+        Check.Sequence(new[] { (2, 1) }, frame.StaticUpdates, "Fallback denominator must keep its original cursor");
+        Check.Sequence(frame.ShellDraws, frame.DynamicUpdates, "Fallback material updates");
+        Check.Sequence(new[] { 2, 5, 2 }, frame.Layers.Select(layer => layer.GetterCalls), "Per-layer cursor reads");
+        AssertOutsideShellLoop(frame, 10, [1, 2, 3]);
+        AssertFixtureFields(frame);
+    }
+
+    private static void EmptyLayer(bool batched, int counter)
+    {
+        var original = CompileLoop(false);
+        var rewritten = CompileLoop(true);
+        var baseline = Frame(counter, new LayerFixture(4, 1, batched));
+        var actual = Frame(counter, new LayerFixture(4, 1, batched));
+        Check.Equal(Canary, original(baseline), "Original empty layer continuation");
+        Check.Equal(Canary, rewritten(actual), "Empty layers must not divide by zero on refresh frames");
+        AssertSameFrame(baseline, actual);
+        Check.Equal(0, actual.ShellDraws.Count, "Cursor=1 denotes no shell slots");
+        AssertOutsideShellLoop(actual, counter, [4]);
