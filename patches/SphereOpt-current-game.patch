@@ -0,0 +1,113 @@
+// Only the production patch's external effects and game data are replaced.
+// No rendering, eligibility/readiness calculation, shader or resource code runs.
+public enum ERenderPlace { Universe, Starmap, Dysonmap, DemoScene, Unsupported }
+
+public sealed class Player { }
+public sealed class GameData { public Player mainPlayer = new(); }
+public sealed class StarData { public int id = 17; }
+
+public sealed class DysonSphere
+{
+    public static ERenderPlace renderPlace;
+    public GameData gameData = new();
+    public StarData starData = new();
+    public DysonSphereLayer[] layersIdBased = new DysonSphereLayer[11];
+}
+
+public sealed class DysonSphereLayer
+{
+    public int id;
+    public int shellCursor;
+    public DysonSphere dysonSphere;
+}
+
+public sealed class DysonSphereSegmentRenderer
+{
+    public DysonSphere dysonSphere;
+}
+
+public static class PerformanceMonitor { public static bool GpuProfilerOn; }
+
+namespace SphereOpt
+{
+    public static class SphereOpt
+    {
+        internal static bool Active;
+        internal static readonly Dictionary<DysonSphere, InstDysonShellRenderer> Renderers = new();
+        internal static readonly List<DysonSphere> Lookups = new();
+        internal static readonly List<Exception> DisableCalls = new();
+        internal static Exception LookupFailure;
+        internal static int ReleaseCalls;
+
+        public static InstDysonShellRenderer getInstDysonShellRendererForSphere(DysonSphere sphere)
+        {
+            Lookups.Add(sphere);
+            if (LookupFailure != null) throw LookupFailure;
+            return Renderers[sphere];
+        }
+
+        internal static void Disable(Exception exception)
+        {
+            // This is a fake external effect, not a test of production Disable.
+            Active = false;
+            DisableCalls.Add(exception);
+        }
+
+        internal static void ReleaseRenderers() => ReleaseCalls++;
+
+        internal static void Reset()
+        {
+            Active = true;
+            Renderers.Clear();
+            Lookups.Clear();
+            DisableCalls.Clear();
+            LookupFailure = null;
+            ReleaseCalls = 0;
+            PerformanceMonitor.GpuProfilerOn = false;
+            DysonSphere.renderPlace = ERenderPlace.Universe;
+        }
+    }
+
+    public sealed class InstDysonShellRenderer
+    {
+        internal int PreparedMask;
+        internal int[] SuccessfulLayers = [];
+        internal Exception PreparationFailure;
+        internal Exception SubmissionFailure;
+        internal int FailAfterCallbacks = -1;
+        internal Action Preparing;
+        internal Action BeforeSubmission;
+        internal Action<int> AfterCallback;
+        internal readonly List<(ERenderPlace Place, int EditorMask, int GameMask)> PrepareCalls = new();
+        internal readonly List<(ERenderPlace Place, int EditorMask, int GameMask)> RenderCalls = new();
+        internal readonly List<int> Callbacks = new();
+
+        internal int PrepareFrame(ERenderPlace place, int editorMask, int gameMask)
+        {
+            PrepareCalls.Add((place, editorMask, gameMask));
+            Preparing?.Invoke();
+            if (PreparationFailure != null) throw PreparationFailure;
+            return PreparedMask;
+        }
+
+        internal void RenderShells(ERenderPlace place, int editorMask, int gameMask, Action<int> submitted)
+        {
+            RenderCalls.Add((place, editorMask, gameMask));
+            BeforeSubmission?.Invoke();
+            ThrowAt(0);
+            foreach (var id in SuccessfulLayers)
+            {
+                // The fake reports success only after its simulated submission.
+                Callbacks.Add(id);
+                submitted(id);
+                AfterCallback?.Invoke(id);
+                ThrowAt(Callbacks.Count);
+            }
+        }
+
+        private void ThrowAt(int callbackCount)
+        {
+            if (SubmissionFailure != null && FailAfterCallbacks == callbackCount) throw SubmissionFailure;
+        }
+    }
+}
diff --git a/tests/SphereOpt.RenderTests/Program.cs b/tests/SphereOpt.RenderTests/Program.cs
