+using HarmonyLib;
+using UnityEngine;
+
+namespace SphereOpt
+{
+    // Installed game assemblies keep these fields private. Cache Harmony accessors
+    // instead of compiling against publicized copies of old game assemblies.
+    internal static class GameAccess
+    {
+        internal static readonly AccessTools.FieldRef<DysonShell, VectorLF3[]> ShellNormals =
+            AccessTools.FieldRefAccess<DysonShell, VectorLF3[]>("polyn");
+        internal static readonly AccessTools.FieldRef<DysonShell, bool> ShellClockwise =
+            AccessTools.FieldRefAccess<DysonShell, bool>("clockwise");
+        internal static readonly AccessTools.FieldRef<DysonShell, VectorLF3> ShellCenter =
+            AccessTools.FieldRefAccess<DysonShell, VectorLF3>("center");
+        internal static readonly AccessTools.FieldRef<DysonShell, double> ShellRadius =
+            AccessTools.FieldRefAccess<DysonShell, double>("radius");
+        internal static readonly AccessTools.FieldRef<DysonSphereSegmentRenderer, Material[]> SegmentMaterials =
+            AccessTools.FieldRefAccess<DysonSphereSegmentRenderer, Material[]>("instMats");
+
+        internal static void Validate()
+        {
+            // Accessing a member runs the type initializer before patches are installed.
+            _ = ShellNormals;
+        }
+    }
+}
