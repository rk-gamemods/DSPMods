index 0000000000000000000000000000000000000000..a498c10e3f71b057fadf6832530a47d37beeb30d
--- /dev/null
+++ b/tests/SphereOpt.Tests/ColorStoreRewriterTests.cs
@@ -0,0 +1,296 @@
+using System.Reflection;
+using System.Reflection.Emit;
+using HarmonyLib;
+
+namespace SphereOpt.Tests;
+
+internal static class ColorStoreRewriterTests
+{
+    private const int Canary = 0x24681357;
+    private static readonly FieldInfo Color = Field<PaintFixture>(nameof(PaintFixture.color));
+    private static readonly MethodInfo Setter = Method(nameof(SetColor));
+    private static readonly MethodInfo MakeColor = Method(nameof(ColorFromSeed));
+
+    internal static IEnumerable<(string, Action)> Cases()
+    {
+        yield return Executable("constant", Constant, 19, false, [ColorFromSeed(42)]);
+        yield return Executable("arithmetic and method expression", Arithmetic, -11, false, [ColorFromSeed(-74)]);
+        yield return Executable("field expression", FieldExpression, 0, false, [new PaintColor(0x12345678)]);
+        yield return Executable("branch true, label on replaced store", Branch, 23, true, [ColorFromSeed(23)]);
+        yield return Executable("branch false, label on replaced store", Branch, 23, false, [ColorFromSeed(42)]);
+        yield return Executable("multiple stores and unrelated fields", MultipleStores, 31, false,
+            [ColorFromSeed(31), ColorFromSeed(32)]);
+        yield return Executable("try/catch/finally normal path", ExceptionRegions, 59, false,
+            [ColorFromSeed(59), ColorFromSeed(77)]);
+        yield return Executable("try/catch/finally exceptional path", ExceptionRegions, 59, true,
+            [ColorFromSeed(-1), ColorFromSeed(77)]);
+        yield return ("ColorStore/metadata and input ownership", MetadataAndInputOwnership);
+        yield return ("ColorStore/empty no-match fails closed", () =>
+            Check.Throws<InvalidOperationException>(() => Rewrite([])));
+        yield return ("ColorStore/unrelated stores and color reads fail closed", () =>
+        {
+            CodeInstruction[] instructions =
+            [
+                I(OpCodes.Ldarg_0), I(OpCodes.Ldarg_0), I(OpCodes.Ldfld, Color),
+                I(OpCodes.Stfld, Field<PaintFixture>(nameof(PaintFixture.accent))), I(OpCodes.Ret)
+            ];
+            var snapshots = instructions.Select(Snapshot.Take).ToArray();
+            Check.Throws<InvalidOperationException>(() => Rewrite(instructions));
+            AssertInputUnmodified(instructions, snapshots);
+        });
+        yield return ("ColorStore/repeated rewrite fails closed", () =>
+        {
+            var once = Rewrite([I(OpCodes.Stfld, Color)]);
+            Check.Throws<InvalidOperationException>(() => Rewrite(once));
+            Check.Equal(OpCodes.Call, once[0].opcode, "Prior successful result was modified");
+        });
+        yield return ("ColorStore/null arguments rejected", () =>
+        {
+            Check.Throws<ArgumentNullException>(() => ColorStoreRewriter.Replace(null!, Color, Setter).ToArray(), "instructions");
+            Check.Throws<ArgumentNullException>(() => ColorStoreRewriter.Replace([], null!, Setter).ToArray(), "colorField");
+            Check.Throws<ArgumentNullException>(() => ColorStoreRewriter.Replace([], Color, null!).ToArray(), "setter");
+        });
+    }
+
+    private static (string, Action) Executable(string name,
+        Func<ILGenerator, List<CodeInstruction>> fixture, int input, bool branch, PaintColor[] notifications)
+        => ($"ColorStore/executable {name}", () =>
+        {
+            var original = Compile(fixture, false);
+            var rewritten = Compile(fixture, true);
+            var baseline = new PaintFixture();
+            var actual = new PaintFixture();
+            Check.Equal(Canary, original(baseline, input, branch), "Original stack canary");
+            Check.Equal(Canary, rewritten(actual, input, branch), "Setter must consume exactly instance and value");
+            Check.Equal(0, baseline.Notifications.Count, "Unrewritten stfld must not notify");
+            Check.Equal(baseline.color, actual.color, "Rewritten color differs from executable baseline");
+            Check.Equal(notifications[^1], actual.color, "Final color");
+            Check.Sequence(notifications, actual.Notifications, "Each executed matching store must notify exactly once");
+            Check.Equal(baseline.accent, actual.accent, "Unrelated field changed");
+            Check.Equal(baseline.Other.color, actual.Other.color, "Same-name field on a different type changed");
+            Check.Equal(baseline.FinallyCount, actual.FinallyCount, "Exception regions changed");
+            if (fixture == MultipleStores)
+            {
+                Check.Equal(ColorFromSeed(91), actual.accent, "Unrelated store must still execute");
+                Check.Equal(ColorFromSeed(92), actual.Other.color, "Same-name unrelated store must still execute");
+            }
+            if (fixture == ExceptionRegions) Check.Equal(1, actual.FinallyCount, "Finally must execute exactly once");
+        });
+
+    private static Func<PaintFixture, int, bool, int> Compile(
+        Func<ILGenerator, List<CodeInstruction>> fixture, bool rewrite)
+    {
+        var method = new DynamicMethod("PaintFixture", typeof(int),
+            [typeof(PaintFixture), typeof(int), typeof(bool)], typeof(ColorStoreRewriterTests).Module, true);
+        var generator = method.GetILGenerator();
+        var original = fixture(generator);
+        var snapshots = original.Select(Snapshot.Take).ToArray();
+        var output = rewrite ? Rewrite(original) : original;
+        AssertInputUnmodified(original, snapshots);
+        if (rewrite) AssertMetadataPreserved(original, output);
+        EmitFixture(generator, output);
+        return method.CreateDelegate<Func<PaintFixture, int, bool, int>>();
+    }
+
+    private static List<CodeInstruction> Constant(ILGenerator _)
+        => [I(OpCodes.Ldc_I4, Canary), I(OpCodes.Ldarg_0), I(OpCodes.Ldc_I4, 42),
+            I(OpCodes.Call, MakeColor), I(OpCodes.Stfld, Color), I(OpCodes.Ret)];
+
+    private static List<CodeInstruction> Arithmetic(ILGenerator _)
+        => [I(OpCodes.Ldc_I4, Canary), I(OpCodes.Ldarg_0), I(OpCodes.Ldarg_1),
+            I(OpCodes.Ldc_I4, 7), I(OpCodes.Mul), I(OpCodes.Ldc_I4, 3), I(OpCodes.Add),
+            I(OpCodes.Call, MakeColor), I(OpCodes.Stfld, Color), I(OpCodes.Ret)];
+
+    private static List<CodeInstruction> FieldExpression(ILGenerator _)
+        => [I(OpCodes.Ldc_I4, Canary), I(OpCodes.Ldarg_0), I(OpCodes.Ldarg_0),
+            I(OpCodes.Ldfld, Field<PaintFixture>(nameof(PaintFixture.SeedColor))),
+            I(OpCodes.Stfld, Color), I(OpCodes.Ret)];
+
+    private static List<CodeInstruction> Branch(ILGenerator generator)
+    {
+        var otherwise = generator.DefineLabel();
+        var store = generator.DefineLabel();
+        return
+        [
+            I(OpCodes.Ldc_I4, Canary), I(OpCodes.Ldarg_0), I(OpCodes.Ldarg_2),
+            I(OpCodes.Brfalse, otherwise), I(OpCodes.Ldarg_1), I(OpCodes.Call, MakeColor),
+            I(OpCodes.Br, store), Labelled(I(OpCodes.Ldc_I4, 42), otherwise),
+            I(OpCodes.Call, MakeColor), Labelled(I(OpCodes.Stfld, Color), store), I(OpCodes.Ret)
+        ];
+    }
+
+    private static List<CodeInstruction> MultipleStores(ILGenerator _)
+        =>
+        [
+            I(OpCodes.Ldc_I4, Canary),
+            I(OpCodes.Ldarg_0), I(OpCodes.Ldarg_1), I(OpCodes.Call, MakeColor), I(OpCodes.Stfld, Color),
+            I(OpCodes.Ldarg_0), I(OpCodes.Ldc_I4, 91), I(OpCodes.Call, MakeColor),
+            I(OpCodes.Stfld, Field<PaintFixture>(nameof(PaintFixture.accent))),
+            I(OpCodes.Ldarg_0), I(OpCodes.Ldfld, Field<PaintFixture>(nameof(PaintFixture.Other))),
+            I(OpCodes.Ldc_I4, 92), I(OpCodes.Call, MakeColor),
+            I(OpCodes.Stfld, Field<OtherPaintFixture>(nameof(OtherPaintFixture.color))),
+            I(OpCodes.Ldarg_0), I(OpCodes.Ldarg_1), I(OpCodes.Ldc_I4_1), I(OpCodes.Add),
+            I(OpCodes.Call, MakeColor), I(OpCodes.Stfld, Color), I(OpCodes.Ret)
+        ];
+
+    private static List<CodeInstruction> ExceptionRegions(ILGenerator generator)
+    {
+        var normal = generator.DefineLabel();
+        return
+        [
+            Block(I(OpCodes.Ldarg_2), ExceptionBlockType.BeginExceptionBlock),
+            I(OpCodes.Brfalse, normal),
+            I(OpCodes.Newobj, typeof(InvalidOperationException).GetConstructor(Type.EmptyTypes)!), I(OpCodes.Throw),
+            Labelled(I(OpCodes.Ldarg_0), normal), I(OpCodes.Ldarg_1), I(OpCodes.Call, MakeColor), I(OpCodes.Stfld, Color),
+            Block(I(OpCodes.Pop), ExceptionBlockType.BeginCatchBlock, typeof(InvalidOperationException)),
+            I(OpCodes.Ldarg_0), I(OpCodes.Ldc_I4_M1), I(OpCodes.Call, MakeColor), I(OpCodes.Stfld, Color),
+            Block(I(OpCodes.Ldarg_0), ExceptionBlockType.BeginFinallyBlock),
+            I(OpCodes.Ldarg_0), I(OpCodes.Ldfld, Field<PaintFixture>(nameof(PaintFixture.FinallyCount))),
+            I(OpCodes.Ldc_I4_1), I(OpCodes.Add), I(OpCodes.Stfld, Field<PaintFixture>(nameof(PaintFixture.FinallyCount))),
+            I(OpCodes.Ldarg_0), I(OpCodes.Ldc_I4, 77), I(OpCodes.Call, MakeColor),
+            Block(I(OpCodes.Stfld, Color), ExceptionBlockType.EndExceptionBlock),
+            I(OpCodes.Ldc_I4, Canary), I(OpCodes.Ret)
+        ];
+    }
+
+    private static void MetadataAndInputOwnership()
+    {
+        var generator = new DynamicMethod("MetadataOnly", typeof(void), Type.EmptyTypes).GetILGenerator();
+        var replaced = Labelled(I(OpCodes.Stfld, Color), generator.DefineLabel());
+        replaced.labels.Add(generator.DefineLabel());
+        // Exercise every Harmony metadata kind, independently of executable fixtures.
+        foreach (var type in Enum.GetValues<ExceptionBlockType>())
+            replaced.blocks.Add(new ExceptionBlock(type, typeof(InvalidOperationException)));
+        var unrelated = Labelled(I(OpCodes.Nop), generator.DefineLabel());
+        unrelated.blocks.Add(new ExceptionBlock(ExceptionBlockType.BeginExceptionBlock));
+        CodeInstruction[] original = [unrelated, replaced, I(OpCodes.Stfld, Color)];
+        var snapshots = original.Select(Snapshot.Take).ToArray();
+        var output = Rewrite(original);
+        AssertInputUnmodified(original, snapshots);
+        AssertMetadataPreserved(original, output);
+        Check.Equal(2, output.Count(instruction => instruction.opcode == OpCodes.Call && Equals(instruction.operand, Setter)),
+            "All matching stores must be replaced");
+        for (var index = 0; index < original.Length; index++)
+        {
+            Check.True(!ReferenceEquals(original[index], output[index]), "Rewriter returned an original instruction");
+            Check.True(!ReferenceEquals(original[index].labels, output[index].labels), "Label list is shared");
+            Check.True(!ReferenceEquals(original[index].blocks, output[index].blocks), "Exception list is shared");
+            output[index].opcode = OpCodes.Nop;
+            output[index].operand = null;
+            output[index].labels.Clear();
+            output[index].blocks.Clear();
+        }
+        AssertInputUnmodified(original, snapshots);
+    }
+
+    private static void AssertMetadataPreserved(IReadOnlyList<CodeInstruction> original, IReadOnlyList<CodeInstruction> output)
+    {
+        Check.Equal(original.Count, output.Count, "Instruction count");
+        for (var index = 0; index < original.Count; index++)
+        {
+            Check.Sequence(original[index].labels, output[index].labels, $"Labels at {index}");
+            Check.Sequence(original[index].blocks.Select(block => (block.blockType, block.catchType)),
+                output[index].blocks.Select(block => (block.blockType, block.catchType)), $"Exception metadata at {index}");
+        }
+    }
+
+    private sealed record Snapshot(OpCode Opcode, object? Operand, Label[] Labels,
+        (ExceptionBlockType, Type)[] Blocks, object LabelList, object BlockList)
+    {
+        internal static Snapshot Take(CodeInstruction instruction)
+            => new(instruction.opcode, instruction.operand, instruction.labels.ToArray(),
+                instruction.blocks.Select(block => (block.blockType, block.catchType)).ToArray(),
+                instruction.labels, instruction.blocks);
+    }
+
+    private static void AssertInputUnmodified(IReadOnlyList<CodeInstruction> original, Snapshot[] snapshots)
+    {
+        Check.Equal(snapshots.Length, original.Count, "Original instruction count");
+        for (var index = 0; index < snapshots.Length; index++)
+        {
+            var saved = snapshots[index];
+            var actual = original[index];
+            Check.Equal(saved.Opcode, actual.opcode, "Original opcode changed");
+            Check.Equal(saved.Operand, actual.operand, "Original operand changed");
+            Check.Sequence(saved.Labels, actual.labels, "Original labels changed");
+            Check.Sequence(saved.Blocks, actual.blocks.Select(block => (block.blockType, block.catchType)), "Original blocks changed");
+            Check.Same(saved.LabelList, actual.labels, "Original label list replaced");
+            Check.Same(saved.BlockList, actual.blocks, "Original exception list replaced");
+        }
+    }
+
+    // A deliberately restricted fixture emitter: it executes only the opcodes and
+    // operand kinds used above and never reads or executes arbitrary game IL.
+    private static void EmitFixture(ILGenerator generator, IEnumerable<CodeInstruction> instructions)
+    {
+        foreach (var instruction in instructions)
+        {
+            foreach (var block in instruction.blocks.Where(block => block.blockType != ExceptionBlockType.EndExceptionBlock))
+            {
+                switch (block.blockType)
+                {
+                    case ExceptionBlockType.BeginExceptionBlock: generator.BeginExceptionBlock(); break;
+                    case ExceptionBlockType.BeginCatchBlock: generator.BeginCatchBlock(block.catchType); break;
+                    case ExceptionBlockType.BeginFinallyBlock: generator.BeginFinallyBlock(); break;
+                    default: throw new NotSupportedException($"Fixture exception boundary {block.blockType}");
+                }
+            }
+            foreach (var label in instruction.labels) generator.MarkLabel(label);
+            switch (instruction.operand)
+            {
+                case null: generator.Emit(instruction.opcode); break;
+                case int value: generator.Emit(instruction.opcode, value); break;
+                case FieldInfo field: generator.Emit(instruction.opcode, field); break;
+                case MethodInfo method: generator.Emit(instruction.opcode, method); break;
+                case ConstructorInfo constructor: generator.Emit(instruction.opcode, constructor); break;
+                case Label label: generator.Emit(instruction.opcode, label); break;
+                default: throw new NotSupportedException($"Fixture operand {instruction.operand.GetType()}");
+            }
+            foreach (var block in instruction.blocks.Where(block => block.blockType == ExceptionBlockType.EndExceptionBlock))
+                generator.EndExceptionBlock();
+        }
+    }
+
+    private static List<CodeInstruction> Rewrite(IEnumerable<CodeInstruction> instructions)
+        => ColorStoreRewriter.Replace(instructions, Color, Setter).ToList();
+
+    private static CodeInstruction I(OpCode opcode, object? operand = null) => new(opcode, operand);
+    private static FieldInfo Field<T>(string name) => AccessTools.Field(typeof(T), name)
+        ?? throw new InvalidOperationException($"Missing fixture field {typeof(T).Name}.{name}");
+    private static MethodInfo Method(string name) => AccessTools.Method(typeof(ColorStoreRewriterTests), name)
+        ?? throw new InvalidOperationException($"Missing fixture method {name}");
+    private static CodeInstruction Labelled(CodeInstruction instruction, Label label)
+    {
+        instruction.labels.Add(label);
+        return instruction;
+    }
+    private static CodeInstruction Block(CodeInstruction instruction, ExceptionBlockType type, Type? catchType = null)
+    {
+        instruction.blocks.Add(new ExceptionBlock(type, catchType));
+        return instruction;
+    }
+
+    private static PaintColor ColorFromSeed(int seed) => new(unchecked((uint)seed * 0x01010101u) | 0xFF000000u);
+    private static void SetColor(PaintFixture instance, PaintColor value)
+    {
+        instance.color = value;
+        instance.Notifications.Add(value);
+    }
+}
+
+internal readonly record struct PaintColor(uint Packed);
+
+internal sealed class PaintFixture
+{
+    public PaintColor color = new(0xAABBCCDD);
+    public PaintColor accent = new(0x55667788);
+    public PaintColor SeedColor = new(0x12345678);
+    public OtherPaintFixture Other = new();
+    public int FinallyCount = 0;
+    public List<PaintColor> Notifications { get; } = [];
+}
+
+internal sealed class OtherPaintFixture
+{
+    public PaintColor color = new(0x99887766);
+}
