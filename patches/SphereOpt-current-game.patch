+        switch (bypass)
+        {
+            case Bypass.Inactive: Plugin.Active = false; break;
+            case Bypass.Profiler: PerformanceMonitor.GpuProfilerOn = true; break;
+            case Bypass.Demo: DysonSphere.renderPlace = place = ERenderPlace.DemoScene; break;
+            case Bypass.Unsupported: DysonSphere.renderPlace = place = ERenderPlace.Unsupported; break;
+            case Bypass.GlobalMismatch: DysonSphere.renderPlace = ERenderPlace.Starmap; break;
+            case Bypass.MissingSphere: fixture.Segment.dysonSphere = null; break;
+            case Bypass.MissingGameData: fixture.Sphere.gameData = null; break;
+            case Bypass.NullPlayer: fixture.Sphere.gameData.mainPlayer = null; break;
+            case Bypass.MissingStar: fixture.Sphere.starData = null; break;
+            case Bypass.ZeroMask: fixture.Native.PreparedMask = 0; break;
+            default: throw new ArgumentOutOfRangeException(nameof(bypass));
+        }
+    }
