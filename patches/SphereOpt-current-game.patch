--- /dev/null
+++ b/tests/SphereOpt.Tests/ShaderBundleIdentityTests.cs
@@ -0,0 +1,84 @@
+using System.Security.Cryptography;
+
+namespace SphereOpt.Tests;
+
+internal static class ShaderBundleIdentityTests
+{
+    private const string ExpectedSha256 = "ea9719ae0307a1bbf07fae22f4c6dff485091a6ab4610065a2ba1883564ba75b";
+
+    internal static IEnumerable<(string, Action)> Cases()
+    {
+        yield return ("ShaderBundleIdentity/pinned repaired bundle hash", () =>
+            Check.Equal(ExpectedSha256, global::SphereOpt.ShaderBundleIdentity.Sha256, "Repaired bundle identity"));
+        yield return ("ShaderBundleIdentity/real repaired bundle accepted", () =>
+        {
+            var bytes = ReadBundle();
+            Check.Equal(ExpectedSha256, Convert.ToHexString(SHA256.HashData(bytes)).ToLowerInvariant(),
+                "Public mod bundle fixture must contain the repaired bytes");
+            global::SphereOpt.ShaderBundleIdentity.Verify(bytes);
+        });
+        yield return ("ShaderBundleIdentity/null rejected", () =>
+            Check.Throws<ArgumentNullException>(() => global::SphereOpt.ShaderBundleIdentity.Verify(null!), "bytes"));
+        yield return ("ShaderBundleIdentity/empty bytes rejected", () => RejectUnchanged([]));
+        yield return ("ShaderBundleIdentity/unrelated bytes rejected", () => RejectUnchanged([1, 2, 3, 4]));
+        yield return ("ShaderBundleIdentity/same length wrong bytes rejected", () =>
+            RejectUnchanged(new byte[ReadBundle().Length]));
+
+        foreach (var location in new[] { "first", "middle", "last" })
+            yield return ($"ShaderBundleIdentity/corrupt {location} byte rejected", () =>
+            {
+                var bytes = ReadBundle();
+                var index = location == "first" ? 0 : location == "middle" ? bytes.Length / 2 : bytes.Length - 1;
+                bytes[index] ^= 1;
+                RejectUnchanged(bytes);
+            });
+
+        yield return ("ShaderBundleIdentity/one byte truncated bundle rejected", () =>
+            RejectUnchanged(ReadBundle()[..^1]));
+        yield return ("ShaderBundleIdentity/half truncated bundle rejected", () =>
+        {
+            var bytes = ReadBundle();
+            RejectUnchanged(bytes[..(bytes.Length / 2)]);
+        });
+        yield return ("ShaderBundleIdentity/appended byte rejected", () =>
+        {
+            var bytes = ReadBundle();
+            Array.Resize(ref bytes, bytes.Length + 1);
+            RejectUnchanged(bytes);
+        });
+        yield return ("ShaderBundleIdentity/repeated verification preserves bytes", () =>
+        {
+            var bytes = ReadBundle();
+            var original = bytes.ToArray();
+            for (var repeat = 0; repeat < 3; repeat++)
+            {
+                global::SphereOpt.ShaderBundleIdentity.Verify(bytes);
+                Check.Sequence(original, bytes, "Successful verification must not mutate bundle bytes");
+            }
+        });
+    }
+
+    private static void RejectUnchanged(byte[] bytes)
+    {
+        var original = bytes.ToArray();
+        for (var repeat = 0; repeat < 2; repeat++)
+        {
+            Check.Throws<InvalidDataException>(() => global::SphereOpt.ShaderBundleIdentity.Verify(bytes));
+            Check.Sequence(original, bytes, "Rejected verification must not mutate bundle bytes");
+        }
+    }
+
+    private static byte[] ReadBundle()
+    {
+        // This is the public mod bundle, read only as bytes. No game inputs,
+        // Unity loader, current-directory assumption or Git process is needed.
+        for (var ancestor = new DirectoryInfo(AppContext.BaseDirectory); ancestor is not null; ancestor = ancestor.Parent)
+        {
+            var path = Path.Combine(ancestor.FullName, "external", "SphereOpt", "thunderstore", "sphereopt-bundle");
+            if (File.Exists(path)) return File.ReadAllBytes(path);
+            path = Path.Combine(ancestor.FullName, "thunderstore", "sphereopt-bundle");
+            if (File.Exists(path)) return File.ReadAllBytes(path);
+        }
+        throw new FileNotFoundException("Cannot locate the public thunderstore/sphereopt-bundle fixture in workspace ancestors.");
+    }
+}
