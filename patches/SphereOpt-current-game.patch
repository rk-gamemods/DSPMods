@@ -0,0 +1,29 @@
+using System;
+
+namespace SphereOpt
+{
+    internal static class ShellBatchPolicy
+    {
+        // The hash-pinned repaired program supports the ordinary and pole bases.
+        internal static bool HasValidCenter(double x, double y, double z)
+        {
+            var lengthSquared = x * x + y * y + z * z;
+            if (double.IsNaN(lengthSquared) || double.IsInfinity(lengthSquared) || lengthSquared <= 0) return false;
+            return true;
+        }
+
+        internal static bool HasValidProgress(int points, int start, int end, int pointsPerVertex, float fillOrder)
+        {
+            if (points < 0 || start < 0 || end <= start || pointsPerVertex <= 0 || float.IsNaN(fillOrder) ||
+                float.IsInfinity(fillOrder) || fillOrder < 0 || fillOrder > 1) return false;
+            return true;
+        }
+
+        internal static float GetProgress(int points, int start, int end, int pointsPerVertex)
+        {
+            if (!HasValidProgress(points, start, end, pointsPerVertex, 1f)) return 0f;
+            var capacity = ((long)end - start) * pointsPerVertex;
+            return points >= capacity ? 1f : (float)(points / (double)capacity);
+        }
+    }
+}
