+// Deterministic API/lifecycle simulation only. These types never call Unity,
+// native graphics APIs, game code, or a plugin runtime.
+using SphereOpt.LayerTests;
+
+namespace UnityEngine
+{
+    public class Object
+    {
+        internal int DestroyCalls { get; private set; }
+        internal bool IsDestroyed => DestroyCalls != 0;
+
+        public static void Destroy(Object target)
+        {
+            if (target == null) return;
+            target.DestroyCalls++;
+            Gpu.Events.Add($"destroy:{target.GetType().Name}");
+        }
+    }
+
+    public static class Shader
+    {
+        private static readonly Dictionary<string, int> Properties = new(StringComparer.Ordinal);
+        public static int PropertyToID(string name)
+        {
+            if (!Properties.TryGetValue(name, out var id))
+            {
+                id = Properties.Count + 1;
+                Properties.Add(name, id);
+            }
+            return id;
+        }
+    }
+
+    public sealed class Material : Object
+    {
+        private readonly Dictionary<int, int> integers = new();
+        internal bool IsTemplate { get; }
+        internal Material Source { get; }
+
+        private Material()
+        {
+            IsTemplate = true;
+            Gpu.Materials.Add(this);
+        }
+
+        internal static Material CreateTemplate() => new();
+
+        public Material(Material source)
+        {
+            Gpu.Hit("Material.ctor");
+            if (source == null || source.IsDestroyed) throw new InvalidOperationException("Invalid source material.");
+            Source = source;
+            foreach (var entry in source.integers) integers.Add(entry.Key, entry.Value);
+            Gpu.Materials.Add(this);
+            Gpu.Events.Add("allocate:Material");
+        }
+
+        public void SetInt(int property, int value)
+        {
+            Gpu.Hit("Material.SetInt");
+            if (IsDestroyed) throw new InvalidOperationException("Use of destroyed material.");
+            integers[property] = value;
+        }
+
+        internal int GetInt(string property) => integers[Shader.PropertyToID(property)];
+    }
+
+    public sealed class ComputeBuffer
+    {
+        public int count { get; }
+        internal int Stride { get; }
+        internal int Id { get; }
+        internal int ReleaseCalls { get; private set; }
+        internal int UploadCalls { get; private set; }
+        internal bool IsReleased => ReleaseCalls != 0;
+        internal Array Uploaded { get; private set; }
+
+        public ComputeBuffer(int count, int stride)
+        {
+            Gpu.BufferConstructorAttempts++;
+            if (count <= 0) Gpu.ZeroCountAttempts++;
+            Gpu.Hit("ComputeBuffer.ctor");
+            if (count <= 0 || stride <= 0) throw new ArgumentOutOfRangeException(nameof(count));
+            this.count = count;
+            Stride = stride;
+            Id = Gpu.Buffers.Count + 1;
+            Gpu.Buffers.Add(this);
+            Gpu.Events.Add($"allocate:ComputeBuffer:{Id}:{count}:{stride}");
+        }
+
+        public void SetData(Array data) => Upload(data);
+        public void SetData<T>(List<T> data) where T : struct => Upload(data.ToArray());
+
+        private void Upload(Array data)
+        {
+            Gpu.Hit("ComputeBuffer.SetData");
+            RequireLive();
+            if (data == null || data.Length > count) throw new ArgumentException("Upload exceeds buffer capacity.");
+            Uploaded = (Array)data.Clone();
+            UploadCalls++;
+            Gpu.Events.Add($"upload:{Id}:{data.Length}");
+        }
+
+        public void Release()
+        {
+            ReleaseCalls++;
+            Gpu.Events.Add($"release:{Id}");
+        }
+
+        internal void RequireLive()
+        {
+            if (IsReleased) throw new InvalidOperationException("Use of released buffer.");
+        }
+
+        internal T[] Data<T>() => (T[])Uploaded;
+    }
+
+    public sealed class MaterialPropertyBlock
+    {
+        private readonly Dictionary<int, ComputeBuffer> buffers = new();
+        private readonly Dictionary<int, float> floats = new();
+
+        public MaterialPropertyBlock() => Gpu.Hit("MaterialPropertyBlock.ctor");
+
+        public void SetBuffer(int property, ComputeBuffer buffer)
+        {
+            Gpu.Hit("MaterialPropertyBlock.SetBuffer");
+            if (buffer == null) throw new ArgumentNullException(nameof(buffer));
+            buffer.RequireLive();
+            buffers[property] = buffer;
+            Gpu.Events.Add($"bind:{property}:{buffer.Id}");
+        }
+
+        public void SetFloat(int property, float value) => floats[property] = value;
+        internal ComputeBuffer Buffer(string property)
+            => buffers.TryGetValue(Shader.PropertyToID(property), out var buffer) ? buffer : null;
+        internal float Float(string property) => floats[Shader.PropertyToID(property)];
+    }
+
+    public struct Vector3
+    {
+        public float x, y, z;
+        public Vector3(float x, float y, float z) { this.x = x; this.y = y; this.z = z; }
+    }
+
+    public struct Color32
+    {
+        public byte r, g, b, a;
+        public Color32(byte r, byte g, byte b, byte a) { this.r = r; this.g = g; this.b = b; this.a = a; }
+    }
+}
+
+public struct VectorLF3
+{
+    public double x, y, z;
+    public VectorLF3(double x, double y, double z) { this.x = x; this.y = y; this.z = z; }
+    public static implicit operator UnityEngine.Vector3(VectorLF3 value)
+        => new((float)value.x, (float)value.y, (float)value.z);
+}
+
+namespace SphereOpt
+{
+    // Only the template material boundary is supplied. The real renderer is not loaded.
+    public static class InstDysonShellRenderer
+    {
+        public static UnityEngine.Material HexMat;
+    }
+}
+
+namespace SphereOpt.LayerTests
+{
+    internal sealed class InjectedFailure : Exception
+    {
+        internal InjectedFailure(string operation) : base($"Injected API/lifecycle failure at {operation}.") { }
+    }
+
+    internal static class Gpu
+    {
+        internal static readonly List<UnityEngine.ComputeBuffer> Buffers = new();
+        internal static readonly List<UnityEngine.Material> Materials = new();
+        internal static readonly List<string> Events = new();
+        internal static int BufferConstructorAttempts;
+        internal static int ZeroCountAttempts;
+        private static string faultOperation;
+        private static int faultCountdown;
+        private static InjectedFailure pendingFailure;
+
+        internal static void Reset()
+        {
+            Buffers.Clear();
+            Materials.Clear();
+            Events.Clear();
+            BufferConstructorAttempts = ZeroCountAttempts = 0;
+            ClearFault();
+            InstDysonShellRenderer.HexMat = UnityEngine.Material.CreateTemplate();
+            InstDysonShellRenderer.HexMat.SetInt(UnityEngine.Shader.PropertyToID("_Stencil"), 17);
+        }
+
+        internal static InjectedFailure Fail(string operation, int occurrence = 1)
+        {
+            Check.True(pendingFailure == null, "Only one fault may be pending.");
+            Check.True(occurrence > 0, "Fault occurrence must be positive.");
+            faultOperation = operation;
+            faultCountdown = occurrence;
+            pendingFailure = new InjectedFailure(operation);
+            return pendingFailure;
+        }
+
+        internal static void Hit(string operation)
+        {
+            if (pendingFailure == null || operation != faultOperation || --faultCountdown != 0) return;
+            var failure = pendingFailure;
+            ClearFault();
+            Events.Add($"fault:{operation}");
+            throw failure;
+        }
+
+        internal static void ClearFault()
+        {
+            pendingFailure = null;
+            faultOperation = null;
+            faultCountdown = 0;
+        }
+
+        internal static void VerifyTeardown()
+        {
+            Check.True(pendingFailure == null, "Configured failure was never exercised.");
+            Check.Equal(0, ZeroCountAttempts, "Attempted zero-count GPU allocation.");
+            foreach (var buffer in Buffers)
+                Check.Equal(1, buffer.ReleaseCalls, $"Buffer {buffer.Id} must be released exactly once.");
+            foreach (var material in Materials)
+                Check.Equal(material.IsTemplate ? 0 : 1, material.DestroyCalls, "Material ownership/destroy count.");
+            Check.Equal(17, InstDysonShellRenderer.HexMat.GetInt("_Stencil"), "Shared template was modified.");
+        }
+    }
+}
diff --git a/tests/SphereOpt.RenderTests/CapturedIlTests.cs b/tests/SphereOpt.RenderTests/CapturedIlTests.cs
new file mode 100644
index 0000000000000000000000000000000000000000..1e329a9b44c5ff4ac696fac0ff699dad62008714
--- /dev/null
+++ b/tests/SphereOpt.RenderTests/CapturedIlTests.cs
@@ -0,0 +1,96 @@
+using System.Globalization;
+using System.Reflection;
+using System.Reflection.Emit;
+using System.Security.Cryptography;
+using HarmonyLib;
+using Mono.Cecil;
+
+namespace SphereOpt.RenderTests;
+
+internal static class CapturedIlTests
+{
+    internal static IEnumerable<(string, Action)> Cases(string assemblyPath)
+    {
+        yield return ("Captured IL/real rewriter transforms the two metadata-backed cursor loads without runtime loading", () => RewriteCaptured(assemblyPath));
+    }
+
+    private static void RewriteCaptured(string assemblyPath)
+    {
+        // Cecil reads the captured PE as data. No Assembly.Load, game dependency
+        // resolution, native code, or captured method execution is involved.
+        var bytes = File.ReadAllBytes(assemblyPath);
+        using var stream = new MemoryStream(bytes, false);
+        using var assembly = AssemblyDefinition.ReadAssembly(stream);
+        var module = assembly.MainModule;
+        var owner = module.Types.Single(type => type.FullName == "DysonSphereSegmentRenderer");
+        var method = owner.Methods.Single(candidate => candidate.Name == "DrawModels");
+        var layer = module.Types.Single(type => type.FullName == "DysonSphereLayer");
+        var field = layer.Fields.Single(candidate => candidate.Name == "shellCursor");
+        Check.Equal("System.Int32", field.FieldType.FullName, "Captured cursor field type");
+        Check.True(method.HasBody, "Captured method body missing");
+        var opcodes = typeof(OpCodes).GetFields(BindingFlags.Public | BindingFlags.Static)
+            .Where(candidate => candidate.FieldType == typeof(OpCode))
+            .Select(candidate => (OpCode)candidate.GetValue(null))
+            .ToDictionary(opcode => unchecked((ushort)opcode.Value));
+        var input = method.Body.Instructions.Select(instruction =>
+        {
+            object operand = instruction.Operand;
+            if (operand is FieldReference reference && reference.MetadataToken == field.MetadataToken &&
+                reference.DeclaringType.FullName == layer.FullName)
+                operand = new CapturedField(module.Mvid, field);
+            return new CodeInstruction(opcodes[unchecked((ushort)instruction.OpCode.Value)], operand);
+        }).ToArray();
+        var cursor = new CapturedField(module.Mvid, field);
+        var matching = input.Select((instruction, index) => (instruction, index))
+            .Where(pair => pair.instruction.opcode == OpCodes.Ldfld && Equals(pair.instruction.operand, cursor))
+            .Select(pair => pair.index).ToArray();
+        Check.Equal(2, matching.Length, "Captured DrawModels must contain precisely two target loads");
+        var capturedLoads = matching.Select(index => method.Body.Instructions[index]).ToArray();
+        Check.Equal(Mono.Cecil.Cil.Code.Rem, capturedLoads[0].Next.OpCode.Code,
+            "First captured cursor read must remain the modulo denominator");
+        Check.True(capturedLoads[1].Next.OpCode.Code is Mono.Cecil.Cil.Code.Blt or Mono.Cecil.Cil.Code.Blt_S &&
+            capturedLoads[1].Next.Operand is Mono.Cecil.Cil.Instruction loopBody && loopBody.Offset < capturedLoads[1].Offset,
+            "Second captured cursor read must remain the bound for a backward shell-loop branch");
+        Check.True(matching.All(index => !ReferenceEquals(cursor, input[index].operand)),
+            "Metadata identity must match independently constructed FieldInfo wrappers");
+        var before = input.Select(instruction => (instruction.opcode, instruction.operand)).ToArray();
+        var output = ShellCursorRewriter.Replace(input, cursor, PatchAccess.CursorMethod).ToArray();
+        Check.Equal(input.Length, output.Length, "Captured instruction count");
+        for (var index = 0; index < input.Length; index++)
+        {
+            var target = matching.Contains(index);
+            Check.Equal(target ? OpCodes.Call : before[index].opcode, output[index].opcode, $"Captured opcode at {index}");
+            Check.Equal(target ? PatchAccess.CursorMethod : before[index].operand, output[index].operand, $"Captured operand at {index}");
+            Check.Equal(before[index].opcode, input[index].opcode, "Captured input opcode changed");
+            Check.Equal(before[index].operand, input[index].operand, "Captured input operand changed");
+            Check.True(!ReferenceEquals(input[index], output[index]), "Captured input instruction returned by reference");
+        }
+        // Raw Cecil branch/switch operands are retained as opaque metadata.
+        // Harmony label/EH reconstruction and executable validity of this full
+        // game body are outside this metadata-only check.
+        Check.True(!cursor.Equals(new CapturedField(Guid.Empty, field)), "Module identity must participate in field equality");
+        Console.WriteLine($"CAPTURE sha256={Convert.ToHexString(SHA256.HashData(bytes)).ToLowerInvariant()} methodToken=0x{method.MetadataToken.ToInt32():x8} instructions={input.Length} cursorLoads={matching.Length} modulo=IL_{capturedLoads[0].Offset:x4} loopBound=IL_{capturedLoads[1].Offset:x4} metadataOnly=true");
+    }
+
+    private sealed class CapturedField(Guid mvid, FieldDefinition field) : FieldInfo
+    {
+        private readonly Guid moduleIdentity = mvid;
+        private readonly int token = field.MetadataToken.ToInt32();
+        public override string Name => field.Name;
+        public override int MetadataToken => token;
+        public override Type DeclaringType => null;
+        public override Type ReflectedType => null;
+        public override Type FieldType => typeof(int); // The captured signature is asserted above.
+        public override System.Reflection.FieldAttributes Attributes => (System.Reflection.FieldAttributes)field.Attributes;
+        public override RuntimeFieldHandle FieldHandle => throw Unsupported();
+        public override Module Module => throw Unsupported();
+        public override object GetValue(object obj) => throw Unsupported();
+        public override void SetValue(object obj, object value, BindingFlags invokeAttr, Binder binder, CultureInfo culture) => throw Unsupported();
+        public override object[] GetCustomAttributes(bool inherit) => throw Unsupported();
+        public override object[] GetCustomAttributes(Type attributeType, bool inherit) => throw Unsupported();
+        public override bool IsDefined(Type attributeType, bool inherit) => throw Unsupported();
+        public override bool Equals(object obj) => obj is CapturedField other && moduleIdentity == other.moduleIdentity && token == other.token;
+        public override int GetHashCode() => HashCode.Combine(moduleIdentity, token);
+        private static NotSupportedException Unsupported() => new("Captured field supports metadata identity only; runtime reflection is forbidden.");
+    }
+}
