+    private static void Emit(ILGenerator generator, IEnumerable<CodeInstruction> instructions)
+    {
+        // Emit only this file's fixture IL. No game or plugin method body is loaded.
+        foreach (var instruction in instructions)
+        {
+            foreach (var block in instruction.blocks.Where(block => block.blockType != ExceptionBlockType.EndExceptionBlock))
+            {
+                switch (block.blockType)
+                {
+                    case ExceptionBlockType.BeginExceptionBlock: generator.BeginExceptionBlock(); break;
+                    case ExceptionBlockType.BeginCatchBlock: generator.BeginCatchBlock(block.catchType); break;
+                    case ExceptionBlockType.BeginFinallyBlock: generator.BeginFinallyBlock(); break;
+                    default: throw new NotSupportedException($"Fixture EH boundary {block.blockType}");
+                }
+            }
+            foreach (var label in instruction.labels) generator.MarkLabel(label);
+            switch (instruction.operand)
+            {
+                case null: generator.Emit(instruction.opcode); break;
+                case int value: generator.Emit(instruction.opcode, value); break;
+                case FieldInfo field: generator.Emit(instruction.opcode, field); break;
+                case MethodInfo method: generator.Emit(instruction.opcode, method); break;
+                case Label label: generator.Emit(instruction.opcode, label); break;
+                case LocalBuilder local: generator.Emit(instruction.opcode, local); break;
+                default: throw new NotSupportedException($"Fixture operand {instruction.operand.GetType()}");
+            }
+            foreach (var block in instruction.blocks.Where(block => block.blockType == ExceptionBlockType.EndExceptionBlock))
+                generator.EndExceptionBlock();
+        }
+    }
