--- /dev/null
+++ b/tests/SphereOpt.Tests/Program.cs
@@ -0,0 +1,85 @@
+using System.Diagnostics;
+
+namespace SphereOpt.Tests;
+
+internal static class Program
+{
+    private static int Main()
+    {
+        // HarmonyX 2.5.5's pinned MonoMod predates .NET 8's DynamicILGenerator
+        // internals. Use its supported in-memory Cecil backend for FieldRefAccess.
+        // This selects the real emitter, not a replacement accessor implementation.
+        // https://github.com/MonoMod/MonoMod.Common/blob/master/Utils/DynamicMethodDefinition.cs
+        Environment.SetEnvironmentVariable("MONOMOD_DMD_TYPE", "cecil", EnvironmentVariableTarget.Process);
+        Environment.SetEnvironmentVariable("MONOMOD_DMD_DUMP", null, EnvironmentVariableTarget.Process);
+        var tests = DispatchPlanTests.Cases()
+            .Concat(ColorStoreRewriterTests.Cases())
+            .Concat(GameAccessTests.Cases())
+            .Concat(PoolCompactionTests.Cases())
+            .Concat(ShellCursorRewriterTests.Cases())
+            .Concat(ShellBatchPolicyTests.Cases())
+            .Concat(ShaderBundleIdentityTests.Cases())
+            .Append(("Isolation/no game or plugin assembly loaded", (Action)AssertIsolated))
+            .ToArray();
+        var failed = 0;
+        var elapsed = Stopwatch.StartNew();
+        foreach (var (name, run) in tests)
+        {
+            try
+            {
+                run();
+                Console.WriteLine($"PASS {name}");
+            }
+            catch (Exception exception)
+            {
+                failed++;
+                Console.Error.WriteLine($"FAIL {name}: {exception}");
+            }
+        }
+        Console.WriteLine($"RESULT total={tests.Length} passed={tests.Length - failed} failed={failed} skipped=0 elapsed={elapsed.Elapsed.TotalSeconds:F3}s");
+        return failed == 0 ? 0 : 1;
+    }
+
+    private static void AssertIsolated()
+    {
+        var forbidden = AppDomain.CurrentDomain.GetAssemblies()
+            .Select(assembly => assembly.GetName().Name ?? "")
+            .Where(name => name == "Assembly-CSharp" || name == "SphereOpt" ||
+                name.StartsWith("UnityEngine", StringComparison.Ordinal) ||
+                name.StartsWith("BepInEx", StringComparison.Ordinal))
+            .ToArray();
+        Check.Equal(0, forbidden.Length, $"Forbidden runtime dependencies: {string.Join(", ", forbidden)}");
+    }
+}
+
+internal static class Check
+{
+    internal static void True(bool condition, string message)
+    {
+        if (!condition) throw new InvalidOperationException(message);
+    }
+
+    internal static void Equal<T>(T expected, T actual, string message = "")
+    {
+        if (!EqualityComparer<T>.Default.Equals(expected, actual))
+            throw new InvalidOperationException($"{message}: expected {expected}, got {actual}");
+    }
+
+    internal static void Same(object expected, object actual, string message)
+        => True(ReferenceEquals(expected, actual), message);
+
+    internal static void Sequence<T>(IEnumerable<T> expected, IEnumerable<T> actual, string message)
+        => True(expected.SequenceEqual(actual), message);
+
+    internal static void Throws<T>(Action action, string? parameter = null) where T : Exception
+    {
+        try { action(); }
+        catch (T exception)
+        {
+            if (parameter is not null)
+                Equal(parameter, (exception as ArgumentException)?.ParamName, "Rejected parameter");
+            return;
+        }
+        throw new InvalidOperationException($"Expected {typeof(T).Name}");
+    }
+}
diff --git a/tests/SphereOpt.Tests/ShaderBundleIdentityTests.cs b/tests/SphereOpt.Tests/ShaderBundleIdentityTests.cs
new file mode 100644
