@@ -0,0 +1,19 @@
+using System;
+using System.IO;
+using System.Security.Cryptography;
+
+namespace SphereOpt
+{
+    internal static class ShaderBundleIdentity
+    {
+        internal const string Sha256 = "ea9719ae0307a1bbf07fae22f4c6dff485091a6ab4610065a2ba1883564ba75b";
+
+        internal static void Verify(byte[] bytes)
+        {
+            if (bytes == null) throw new ArgumentNullException(nameof(bytes));
+            using (var sha = SHA256.Create())
+                if (BitConverter.ToString(sha.ComputeHash(bytes)).Replace("-", "").ToLowerInvariant() != Sha256)
+                    throw new InvalidDataException("SphereOpt requires its matching repaired sphereopt-bundle; the installed bytes differ.");
+        }
+    }
+}
