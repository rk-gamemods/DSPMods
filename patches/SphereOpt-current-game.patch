index 0000000000000000000000000000000000000000..f87e1df94e91a33b68ddb5295df34829d985403c
--- /dev/null
+++ b/tests/SphereOpt.RenderTests/verify_counterfactuals.py
@@ -0,0 +1,79 @@
+"""Prove selected render-patch regressions fail without editing production.
+
+All generated sources and projects stay under the workspace's .local/build.
+Run with: py -3 external/SphereOpt/tests/SphereOpt.RenderTests/verify_counterfactuals.py
+"""
+
+from pathlib import Path
+import subprocess
+from xml.sax.saxutils import quoteattr
+
+
+def main() -> None:
+    tests = Path(__file__).resolve().parent
+    root = tests.parents[3]
+    production = tests.parents[1] / "Patch_DysonSphereSegmentRenderer.cs"
+    source = production.read_text(encoding="utf-8")
+    build = root / ".local/build/SphereOptTests/counterfactuals/RenderTests"
+    mutations = {
+        "clear_completed_mask_on_failure": (
+            "catch (Exception exception) { SphereOpt.Disable(exception); }",
+            "catch (Exception exception) { context.Mask = 0; SphereOpt.Disable(exception); }",
+            "FAIL Failure/submission after layer 1 ",
+        ),
+        "suppress_prepared_before_callbacks": (
+            "context.Sphere = sphere;",
+            "context.Sphere = sphere; context.Mask = mask; "
+            "for (var i = 1; i <= 10; i++) context.Layers[i] = sphere.layersIdBased[i];",
+            "FAIL Masks/all 59,049 ",
+        ),
+        "drop_exact_layer_identity": (
+            "ReferenceEquals(current.Layers[layer.id], layer)",
+            "true",
+            "FAIL Identity/recreated layer ",
+        ),
+    }
+    for name, (old, new, required_failure) in mutations.items():
+        if source.count(old) != 1:
+            raise RuntimeError(f"{name}: mutation anchor must occur exactly once")
+        destination = build / name
+        destination.mkdir(parents=True, exist_ok=True)
+        (destination / "MutatedPatch.cs").write_text(source.replace(old, new), encoding="utf-8")
+        (destination / "packages.lock.json").write_bytes((tests / "packages.lock.json").read_bytes())
+        includes = "".join(f"<Compile Include={quoteattr(str(path))} />" for path in sorted(tests.glob("*.cs")))
+        rewriter = quoteattr(str(production.with_name("ShellCursorRewriter.cs")))
+        project = (
+            '<Project Sdk="Microsoft.NET.Sdk"><PropertyGroup><OutputType>Exe</OutputType>'
+            '<TargetFramework>net8.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings>'
+            '<Nullable>disable</Nullable><NuGetAudit>false</NuGetAudit>'
+            '<RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>'
+            '<RestoreLockedMode>true</RestoreLockedMode></PropertyGroup><ItemGroup>'
+            '<PackageReference Include="HarmonyX" Version="[2.5.5]" />'
+            f"{includes}<Compile Include={rewriter} /></ItemGroup></Project>"
+        )
+        project_path = destination / "Counterfactual.csproj"
+        project_path.write_text(project, encoding="utf-8")
+        print(f"COUNTERFACTUAL running {name}", flush=True)
+        result = subprocess.run(
+            ["dotnet", "run", "--project", str(project_path), "--configuration", "Release"],
+            cwd=root,
+            capture_output=True,
+            text=True,
+            check=False,
+        )
+        output = result.stdout + result.stderr
+        (destination / "result.log").write_text(output, encoding="utf-8")
+        failures = [line for line in output.splitlines() if line.startswith("FAIL ")]
+        summaries = [line for line in output.splitlines() if line.startswith("RESULT ")]
+        rejected = result.returncode != 0 and bool(summaries) and any(
+            line.startswith(required_failure) for line in failures
+        )
+        print(f"COUNTERFACTUAL {name} exit={result.returncode} rejected={rejected}", flush=True)
+        for line in summaries + failures[:3]:
+            print(line, flush=True)
+        if not rejected:
+            raise RuntimeError(f"{name}: mutant did not reach failing assertions\n{output[-6000:]}")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tests/SphereOpt.Tests/ColorStoreRewriterTests.cs b/tests/SphereOpt.Tests/ColorStoreRewriterTests.cs
