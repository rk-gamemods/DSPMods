+                Check.Equal(0, inner.Native.RenderCalls.Count, "Guard must not submit shells");
+                Check.Equal(nested ? 1 : 0, Plugin.Lookups.Count - (bypass == Bypass.ZeroMask ? 1 : 0),
+                    "Guard must not acquire a renderer before eligibility");
+                Check.Equal(0, Plugin.DisableCalls.Count, "Guard must not be treated as an error");
