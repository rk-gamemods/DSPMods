+++ b/ColorStoreRewriter.cs
@@ -0,0 +1,37 @@
+using System;
+using System.Collections.Generic;
+using System.Reflection;
+using System.Reflection.Emit;
+using HarmonyLib;
+
+namespace SphereOpt
+{
+    internal static class ColorStoreRewriter
+    {
+        internal static IEnumerable<CodeInstruction> Replace(IEnumerable<CodeInstruction> instructions,
+            FieldInfo colorField, MethodInfo setter)
+        {
+            if (instructions == null) throw new ArgumentNullException(nameof(instructions));
+            if (colorField == null) throw new ArgumentNullException(nameof(colorField));
+            if (setter == null) throw new ArgumentNullException(nameof(setter));
+            var result = new List<CodeInstruction>();
+            var replacements = 0;
+            foreach (var instruction in instructions)
+            {
+                var replacement = new CodeInstruction(instruction);
+                if (instruction.opcode == OpCodes.Stfld && Equals(instruction.operand, colorField))
+                {
+                    // A static (shell, color) setter consumes exactly the same stack
+                    // values as stfld. Labels and exception boundaries stay attached.
+                    replacement.opcode = OpCodes.Call;
+                    replacement.operand = setter;
+                    replacements++;
+                }
+                result.Add(replacement);
+            }
+            if (replacements == 0)
+                throw new InvalidOperationException("Dyson paint method no longer contains a shell color store.");
+            return result;
+        }
+    }
+}
