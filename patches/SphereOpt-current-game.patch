+++ b/tests/SphereOpt.LayerTests/LayerTests.cs
@@ -0,0 +1,498 @@
+using UnityEngine;
+using Layer = SphereOpt.InstDysonShellLayer;
+
+namespace SphereOpt.LayerTests;
+
+internal static class LayerTests
+{
+    internal static IEnumerable<(string Name, Action Run)> Cases()
+    {
+        yield return ("Material/per-layer stencil and shared-template ownership", Stencil);
+        yield return ("Free/repeated teardown and post-free callbacks", IdempotentFree);
+        foreach (var operation in new[] { "MaterialPropertyBlock.ctor", "Material.ctor", "Material.SetInt" })
+        {
+            var captured = operation;
+            yield return ($"Constructor/cleanup on {operation} failure", () => ConstructorFailure(captured, 1));
+        }
+        for (var occurrence = 1; occurrence <= 3; occurrence++)
+        {
+            var captured = occurrence;
+            yield return ($"Constructor/cleanup on ComputeBuffer #{occurrence} failure", () => ConstructorFailure("ComputeBuffer.ctor", captured));
+            yield return ($"Constructor/cleanup on SetBuffer #{occurrence} failure", () => ConstructorFailure("MaterialPropertyBlock.SetBuffer", captured));
+        }
+        yield return ("Sync/empty layer never allocates a zero-count hex buffer", EmptySync);
+        yield return ("Sync/payload upload, dirty flags and clean-sync no-op", UploadAndDirtyFlags);
+        foreach (var order in new[] { new[] { 7, 2, 9 }, new[] { 2, 9, 7 }, new[] { 9, 7, 2 } })
+        {
+            var captured = order;
+            yield return ($"Compaction/real layer remove order {string.Join(',', order)}", () => RemovalOrder(captured));
+        }
+        yield return ("Compaction/explicit progress count bounds exact owned range", ExplicitProgressCount);
+        yield return ("Regeneration/remove before reusing same shell ID", Regeneration);
+        yield return ("Updates/missing, removed and out-of-range nodes are no-ops", MissingUpdates);
+        yield return ("Removal/unknown ID does not access existing hex storage", UnknownRemovalDoesNotScan);
+        yield return ("Updates/unchanged live values keep buffers clean", UnchangedUpdates);
+        yield return ("Appearance/existing shell keeps allocation after later appends", AppearanceUpdate);
+        foreach (var kind in new[] { "progress", "shell", "polygon", "hex" })
+        {
+            var capturedKind = kind;
+            foreach (var operation in new[] { "ComputeBuffer.ctor", "MaterialPropertyBlock.SetBuffer" })
+            {
+                var capturedOperation = operation;
+                yield return ($"Replacement/{kind} cleanup on {operation} failure and retry", () => ReplacementFailure(capturedKind, capturedOperation));
+            }
+        }
+        for (var occurrence = 1; occurrence <= 4; occurrence++)
+        {
+            var captured = occurrence;
+            yield return ($"Sync/SetData #{occurrence} failure retains ownership and retries", () => UploadFailure(captured));
+        }
+        yield return ("Replacement/SetData failure after hex resize releases all owned buffers", ResizeUploadFailure);
+    }
+
+    private sealed class Fixture : IDisposable
+    {
+        internal Layer Layer { get; } = new(4);
+        public void Dispose() => Layer.Free();
+    }
+
+    private static void UnknownRemovalDoesNotScan()
+    {
+        using var fixture = new Fixture();
+        var layer = fixture.Layer;
+        Add(layer, 7, 2, 3, 2, 70);
+        var hexes = layer.hexPool;
+        // Access to this storage would fail. Unknown ownership must be decided
+        // before touching it, even when other shells are already registered.
+        layer.hexPool = null!;
+        try { layer.RemoveDysonShell(8); }
+        finally { layer.hexPool = hexes; }
+        Check.Equal(2, layer.hexPool.Count, "Unknown removal changed existing geometry.");
+    }
+
+    private static void Stencil()
+    {
+        var layers = new List<Layer>();
+        try
+        {
+            foreach (var id in new[] { 1, 4, 10 }) layers.Add(new Layer(id));
+            Check.Equal(3, layers.Select(layer => layer.Material).Distinct().Count(), "Layer materials are shared.");
+            foreach (var layer in layers)
+            {
+                Check.Equal(layer.layerId + 200, layer.Material.GetInt("_Stencil"), "Per-layer stencil.");
+                Check.Same(InstDysonShellRenderer.HexMat, layer.Material.Source, "Layer must clone HexMat.");
+                Check.True(!ReferenceEquals(layer.Material, InstDysonShellRenderer.HexMat), "Layer owns template directly.");
+            }
+            layers[0].Free();
+            Check.Equal(204, layers[1].Material.GetInt("_Stencil"), "Free affected another layer.");
+            Check.Equal(0, InstDysonShellRenderer.HexMat.DestroyCalls, "Template was destroyed.");
+        }
+        finally { foreach (var layer in layers) layer.Free(); }
+    }
+
+    private static void IdempotentFree()
+    {
+        using var fixture = new Fixture();
+        var layer = fixture.Layer;
+        Add(layer, 3, 2, 3, 2, 30);
+        layer.SyncBufferData();
+        var material = layer.Material;
+        layer.Free();
+        var events = Gpu.Events.Count;
+        layer.Free();
+        layer.SyncBufferData();
+        layer.SetProps();
+        layer.RemoveDysonShell(3);
+        layer.UpdateColor(3, new Color32(1, 2, 3, 4));
+        layer.UpdateState(3, 42);
+        layer.UpdateHexProgress(3, 0, .9f);
+        layer.RegisterProgressCount(3, 2);
+        Check.Equal(events, Gpu.Events.Count, "Repeated Free/callbacks touched resources.");
+        Check.True(layer.Material == null && layer.props == null && layer.hexPool == null && layer.shellPool == null &&
+            layer.hexProgressPool == null && layer.polygonPool == null, "Freed layer retains resources/pools.");
+        Check.Equal(1, material.DestroyCalls, "Owned material destroy count.");
+        Check.Equal(0, layer.progressBaseCursor, "Freed progress cursor.");
+        Check.Equal(0, layer.polygonCursor, "Freed polygon cursor.");
+        Check.Throws<ObjectDisposedException>(() => layer.AddShellData(1, default));
+        Check.Throws<ObjectDisposedException>(() => layer.AddHexProgressData(0, default));
+        Check.Throws<ObjectDisposedException>(() => layer.AddPolygonData(new(), Array.Empty<VectorLF3>(), false));
+        Check.Throws<ObjectDisposedException>(() => layer.SetCapacityShellPool(30));
+        Check.Throws<ObjectDisposedException>(() => layer.SetCapacityHexProgressPool(100));
+        Check.Throws<ObjectDisposedException>(() => layer.SetCapacityPolygonPool(1));
+    }
+
+    private static void ConstructorFailure(string operation, int occurrence)
+    {
+        var failure = Gpu.Fail(operation, occurrence);
+        Check.Same(failure, Check.Throws<InjectedFailure>(() => new Layer(5)), "Constructor replaced the original error.");
+        Check.True(Gpu.Buffers.All(buffer => buffer.ReleaseCalls == 1), "Partial constructor leaked buffer.");
+        Check.True(Gpu.Materials.Where(material => !material.IsTemplate).All(material => material.DestroyCalls == 1), "Partial constructor leaked material.");
+    }
+
+    private static void EmptySync()
+    {
+        using var fixture = new Fixture();
+        var layer = fixture.Layer;
+        var initial = Gpu.Buffers.Count;
+        layer.SyncBufferData();
+        layer.SyncBufferData();
+        Check.Equal(initial, Gpu.Buffers.Count, "Empty sync allocated a hex buffer.");
+        Check.True(layer.props.Buffer("_HexBuffer") == null, "Empty layer bound a hex buffer.");
+        Add(layer, 2, 1, 3, 1, 20);
+        layer.SyncBufferData();
+        var hex = layer.props.Buffer("_HexBuffer");
+        layer.RemoveDysonShell(2);
+        layer.SyncBufferData();
+        Check.Equal(1, hex.ReleaseCalls, "Transition to empty did not release hex buffer.");
+        var count = Gpu.Buffers.Count;
+        layer.hexBufferIsDirty = true;
+        layer.SyncBufferData();
+        Check.Equal(count, Gpu.Buffers.Count, "Repeated empty sync allocated a buffer.");
+        Check.Equal(0, Gpu.ZeroCountAttempts, "Zero-count allocation attempted.");
+        Add(layer, 2, 2, 3, 2, 40);
+        layer.SyncBufferData();
+        Check.True(!ReferenceEquals(hex, layer.props.Buffer("_HexBuffer")), "Repopulated layer reused released buffer.");
+    }
+
+    private static void UploadAndDirtyFlags()
+    {
+        using var fixture = new Fixture();
+        var layer = fixture.Layer;
+        Add(layer, 2, 2, 3, 2, 20);
+        layer.radius = 5100; layer.gridScale = 3; layer.gridSize = 2.5f;
+        layer.SetProps();
+        Check.Equal(5100f, layer.props.Float("_Radius"));
+        Check.Equal(3f, layer.props.Float("_Scale"));
+        Check.Equal(2.5f, layer.props.Float("_GridSize"));
+        Check.Equal(.94f, layer.props.Float("_CellSize"));
+        Check.Equal(4f, layer.props.Float("_LayerId"));
+        layer.SyncBufferData();
+        VerifyUploads(layer);
