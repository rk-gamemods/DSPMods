+        internal LayerFixture(int id, int cursor, bool batched)
+        {
+            Id = id;
+            Batched = batched;
+            OriginalCursor = shellCursor = cursor;
+            AdjacentCursor = 100 + id;
+            Other = new OtherLayerFixture(200 + id);
+            ShellPool = new ShellFixture?[Math.Max(cursor, 1) + 2];
+            for (var index = 1; index < cursor; index++) ShellPool[index] = new ShellFixture(index);
+        }
+    }
+
+    private sealed class OtherLayerFixture(int cursor)
+    {
+        public int shellCursor = cursor;
+    }
+
+    private sealed class ShellFixture(int id)
+    {
+        public int Id = id;
+    }
+}
