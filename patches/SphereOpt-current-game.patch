+    private static void ReplacementFailure(string kind, string operation)
+    {
+        using var fixture = new Fixture();
+        var layer = fixture.Layer;
+        Add(layer, 2, 2, 3, 1, 20);
+        layer.SyncBufferData();
+        var property = kind switch { "progress" => "_HexProgressBuffer", "shell" => "_ShellBuffer", "polygon" => "_PolygonBuffer", _ => "_HexBuffer" };
+        var previous = layer.props.Buffer(property);
+        var oldPayload = (Array)previous.Uploaded.Clone();
+        var oldArray = kind switch { "progress" => (object)layer.hexProgressPool, "shell" => layer.shellPool, "polygon" => layer.polygonPool, _ => layer.hexPool };
+        var cpuSnapshot = oldArray is Array array ? array.Cast<object>().ToArray() : layer.hexPool.Cast<object>().ToArray();
+        Action resize = kind switch
+        {
+            "progress" => () => layer.SetCapacityHexProgressPool(150),
+            "shell" => () => layer.SetCapacityShellPool(40),
+            "polygon" => () => layer.SetCapacityPolygonPool(2),
+            _ => () => layer.SyncBufferData()
+        };
+        if (kind == "hex")
+        {
+            layer.hexPool.Add(new Layer.HexData { shellIndex = 2, nodeIndex = 1, closestPolygon = 1 });
+            layer.hexBufferIsDirty = true;
+        }
+        var allocations = Gpu.Buffers.Count;
+        var dirty = DirtyFlags(layer);
+        var failure = Gpu.Fail(operation);
+        Check.Same(failure, Check.Throws<InjectedFailure>(resize), "Replacement changed failure identity.");
+        Check.Same(previous, layer.props.Buffer(property), "Failed replacement changed binding.");
+        Check.Equal(0, previous.ReleaseCalls, "Failed replacement released original buffer.");
+        var currentArray = kind switch { "progress" => (object)layer.hexProgressPool, "shell" => layer.shellPool, "polygon" => layer.polygonPool, _ => layer.hexPool };
+        Check.Same(oldArray, currentArray, "Failed replacement changed CPU pool.");
+        Check.Sequence(oldPayload.Cast<object>(), previous.Uploaded.Cast<object>(), "Failed replacement changed uploaded payload.");
+        if (kind != "hex") Check.Sequence(cpuSnapshot, ((Array)currentArray).Cast<object>(), "Failed growth changed CPU payload.");
+        Check.True(!previous.IsReleased, "Failed growth made original resource unusable.");
+        Check.Equal(dirty, DirtyFlags(layer), "Failed replacement changed dirty flags.");
+        var created = Gpu.Buffers.Skip(allocations).ToArray();
+        Check.Equal(operation == "ComputeBuffer.ctor" ? 0 : 1, created.Length, "Unexpected failed replacement allocation count.");
+        foreach (var buffer in created) Check.Equal(1, buffer.ReleaseCalls, "Failed binding leaked replacement.");
+        resize();
+        var replacement = layer.props.Buffer(property);
+        Check.True(!ReferenceEquals(previous, replacement), "Retry did not replace buffer.");
+        Check.Equal(1, previous.ReleaseCalls, "Successful replacement retained old resource.");
+        Check.Equal(0, replacement.ReleaseCalls, "New resource was released prematurely.");
+        var bindIndex = Gpu.Events.LastIndexOf($"bind:{Shader.PropertyToID(property)}:{replacement.Id}");
+        var releaseIndex = Gpu.Events.LastIndexOf($"release:{previous.Id}");
+        Check.True(bindIndex >= 0 && bindIndex < releaseIndex, "Old buffer released before replacement binding.");
+        layer.SyncBufferData();
+        VerifyUploads(layer);
+    }
+
+    private static void UploadFailure(int occurrence)
+    {
+        using var fixture = new Fixture();
+        var layer = fixture.Layer;
+        Add(layer, 2, 2, 3, 2, 20);
+        var failure = Gpu.Fail("ComputeBuffer.SetData", occurrence);
+        Check.Same(failure, Check.Throws<InjectedFailure>(layer.SyncBufferData), "Upload changed failure identity.");
+        var dirty = new[] { layer.hexProgressBufferIsDirty, layer.hexBufferIsDirty, layer.shellBufferIsDirty, layer.polygonBufferIsDirty };
+        Check.True(dirty[occurrence - 1], "Failed upload cleared dirty flag.");
+        for (var i = 0; i < occurrence - 1; i++) Check.True(!dirty[i], "Successful preceding upload was left dirty.");
+        Check.True(Gpu.Buffers.All(buffer => buffer.ReleaseCalls == 0), "Upload failure lost owned buffer.");
+        var allocated = Gpu.Buffers.Count;
+        layer.SyncBufferData();
+        Check.Equal(4, Gpu.Buffers.Count, "Retry leaked/duplicated buffers.");
+        Check.True(Gpu.Buffers.Count - allocated <= 1, "Retry allocated unrelated resources.");
+        VerifyUploads(layer);
+        foreach (var buffer in Gpu.Buffers) Check.Equal(1, buffer.UploadCalls, "Retry repeated completed upload.");
+    }
+
+    private static void ResizeUploadFailure()
+    {
+        using var fixture = new Fixture();
+        var layer = fixture.Layer;
+        Add(layer, 2, 2, 3, 1, 20);
+        layer.SyncBufferData();
+        var original = layer.props.Buffer("_HexBuffer");
+        layer.hexPool.Add(new Layer.HexData { shellIndex = 2, nodeIndex = 1, closestPolygon = 2 });
+        layer.hexBufferIsDirty = true;
+        var failure = Gpu.Fail("ComputeBuffer.SetData");
+        Check.Same(failure, Check.Throws<InjectedFailure>(layer.SyncBufferData), "Replacement upload failure identity.");
+        var replacement = layer.props.Buffer("_HexBuffer");
+        Check.True(!ReferenceEquals(original, replacement), "Resize did not create replacement.");
+        Check.Equal(1, original.ReleaseCalls, "Resize retained old buffer.");
+        Check.Equal(0, replacement.ReleaseCalls, "Failed upload discarded owned replacement.");
+        Check.True(layer.hexBufferIsDirty, "Failed replacement upload cannot retry.");
+        layer.Free();
+        layer.Free();
+        Check.Equal(1, replacement.ReleaseCalls, "Free leaked replacement after upload failure.");
+    }
+
+    private sealed record ModelShell(int Id, Layer.HexProgressData[] Progress, Layer.PolygonData[] Polygons, Layer.HexData[] Hexes);
+
+    // Mirrors the real caller's reserve -> AddPolygonData -> AddShellData ->
+    // RegisterProgressCount -> progress/hex append sequence, not its compaction.
+    private static ModelShell Add(Layer layer, int id, int progressCount, int polygonCount, int hexCount, int seed)
+    {
+        var progress = Enumerable.Range(0, progressCount).Select(index => new Layer.HexProgressData { progress = seed + index }).ToArray();
+        var polygons = Enumerable.Range(0, polygonCount).Select(index => new Layer.PolygonData
+        {
+            pos = new Vector3(seed + index, seed + index + .25f, -seed),
+            normal = new Vector3(index, 1, -index)
+        }).ToArray();
+        var progressBase = layer.progressBaseCursor;
+        layer.progressBaseCursor += progressCount;
+        var polygonBase = layer.AddPolygonData(polygons.Select(value => new VectorLF3(value.pos.x, value.pos.y, value.pos.z)).ToList(),
+            polygons.Select(value => new VectorLF3(value.normal.x, value.normal.y, value.normal.z)).ToArray(), false);
+        layer.AddShellData(id, new Layer.ShellData
+        {
+            progressBaseIndex = progressBase, polygonIndex = polygonBase, polyCount = polygonCount,
+            color = seed, state = (uint)seed, protoId = seed % 7, center = new Vector3(seed, 1, 2), clockwise = 1
+        });
+        layer.RegisterProgressCount(id, progressCount);
+        for (var i = 0; i < progress.Length; i++) layer.AddHexProgressData(progressBase + i, progress[i]);
+        var hexes = Enumerable.Range(0, hexCount).Select(index => new Layer.HexData
+        {
+            shellIndex = id, nodeIndex = index % progressCount, closestPolygon = index % polygonCount,
+            pos = new Vector3(seed, index, -index), axialCoords_xy = (uint)(seed * 10 + index), vertFillOrder = seed + index * .5f
+        }).ToArray();
+        layer.hexPool.AddRange(hexes);
+        layer.hexBufferIsDirty = true;
+        return new ModelShell(id, progress, polygons, hexes);
+    }
+
+    private static void VerifyModel(Layer layer, IEnumerable<ModelShell> expected)
+    {
+        var live = expected.ToArray();
+        var progress = live.SelectMany(shell => shell.Progress).ToArray();
+        var polygons = live.SelectMany(shell => shell.Polygons).ToArray();
+        var hexes = live.SelectMany(shell => shell.Hexes).ToArray();
+        Check.Equal(progress.Length, layer.progressBaseCursor, "Progress cursor.");
+        Check.Equal(polygons.Length, layer.polygonCursor, "Polygon cursor.");
+        Check.Sequence(progress, layer.hexProgressPool.Take(progress.Length), "Compaction changed surviving progress.");
+        Check.Sequence(polygons, layer.polygonPool.Take(polygons.Length), "Compaction changed surviving polygons/normals.");
+        Check.Sequence(hexes, layer.hexPool, "Removed hex filtering changed survivors or shell-local node/polygon indices.");
+        Check.True(layer.hexProgressPool.Skip(progress.Length).All(value => value.Equals(default(Layer.HexProgressData))), "Dead progress tail not cleared.");
+        Check.True(layer.polygonPool.Skip(polygons.Length).All(value => value.Equals(default(Layer.PolygonData))), "Dead polygon tail not cleared.");
+        var progressBase = 0; var polygonBase = 0;
+        foreach (var shell in live)
+        {
+            var record = layer.shellPool[shell.Id];
+            Check.Equal(progressBase, record.progressBaseIndex, "Surviving shell progress base.");
+            Check.Equal(polygonBase, record.polygonIndex, "Surviving shell polygon base.");
+            Check.Equal(shell.Polygons.Length, record.polyCount, "Surviving polygon count.");
+            foreach (var hex in layer.hexPool.Where(hex => hex.shellIndex == shell.Id))
+            {
+                Check.Equal(shell.Progress[hex.nodeIndex], layer.hexProgressPool[record.progressBaseIndex + hex.nodeIndex], "Hex references wrong rebased progress.");
+                Check.Equal(shell.Polygons[hex.closestPolygon], layer.polygonPool[record.polygonIndex + hex.closestPolygon], "Hex references wrong rebased polygon.");
+            }
+            progressBase += shell.Progress.Length; polygonBase += shell.Polygons.Length;
+        }
+    }
+
+    private static void VerifyUploads(Layer layer)
+    {
+        Check.Sequence(layer.hexProgressPool, layer.props.Buffer("_HexProgressBuffer").Data<Layer.HexProgressData>(), "Uploaded progress differs from CPU pool.");
+        Check.Sequence(layer.shellPool, layer.props.Buffer("_ShellBuffer").Data<Layer.ShellData>(), "Uploaded shell records differ from CPU pool.");
+        Check.Sequence(layer.polygonPool, layer.props.Buffer("_PolygonBuffer").Data<Layer.PolygonData>(), "Uploaded polygon records differ from CPU pool.");
+        if (layer.hexPool.Count != 0)
+            Check.Sequence(layer.hexPool, layer.props.Buffer("_HexBuffer").Data<Layer.HexData>(), "Uploaded hexes differ from compacted pool.");
+    }
+
+    private static (bool Progress, bool Hex, bool Shell, bool Polygon) DirtyFlags(Layer layer)
+        => (layer.hexProgressBufferIsDirty, layer.hexBufferIsDirty, layer.shellBufferIsDirty, layer.polygonBufferIsDirty);
+}
