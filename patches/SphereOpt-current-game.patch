@@ -0,0 +1,36 @@
+using System;
+using System.Collections.Generic;
+using System.Reflection;
+using System.Reflection.Emit;
+using HarmonyLib;
+
+namespace SphereOpt
+{
+    internal static class ShellCursorRewriter
+    {
+        internal static IEnumerable<CodeInstruction> Replace(IEnumerable<CodeInstruction> instructions,
+            FieldInfo cursor, MethodInfo replacement)
+        {
+            if (instructions == null) throw new ArgumentNullException(nameof(instructions));
+            if (cursor == null) throw new ArgumentNullException(nameof(cursor));
+            if (replacement == null) throw new ArgumentNullException(nameof(replacement));
+            var result = new List<CodeInstruction>();
+            var count = 0;
+            foreach (var instruction in instructions)
+            {
+                var next = new CodeInstruction(instruction);
+                if (instruction.opcode == OpCodes.Ldfld && Equals(instruction.operand, cursor))
+                {
+                    next.opcode = OpCodes.Call;
+                    next.operand = replacement;
+                    count++;
+                }
+                result.Add(next);
+            }
+            // One modulo denominator and one loop bound in the captured game.
+            // Refuse to install this optimization when the owning method changes.
+            if (count != 2) throw new InvalidOperationException("Unsupported Dyson shell render-loop contract: expected two shellCursor reads.");
+            return result;
+        }
+    }
+}
